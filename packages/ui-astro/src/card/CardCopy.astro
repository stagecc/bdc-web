---
import Card from './Card.astro';
import Link from '../link/Link.astro';

interface Props {
  eyebrow: string;
  title: string;
  description: string;
  href: string;
  linkLabel: string;
  headingTag?: 'h2' | 'h3';
  border?: boolean;
}

const {
  eyebrow,
  title,
  description,
  href,
  headingTag = 'h3',
  linkLabel,
  border = true,
} = Astro.props;

const Heading = headingTag;
---

<Card variant="overview" class="height-full display-flex flex-column" border={border}>
  <p class="margin-top-0 margin-bottom-1 text-uppercase text-bold text-ls-2 font-sans-2xs text-primary">{eyebrow}</p>
  <Heading class="margin-top-0 margin-bottom-1 text-primary-dark">
    {title}
  </Heading>
  <div class="display-flex flex-justify">
    <p class="margin-y-0 text-base line-height-sans-5">{description}</p>
    <Link class="usa-link text-bold" to={href}>{linkLabel}</Link>
  </div>
</Card>
