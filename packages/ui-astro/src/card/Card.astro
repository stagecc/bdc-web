---
interface Props extends astroHTML.JSX.HTMLAttributes<'article'> {
  variant?: 'feature' | 'dataset' | 'panel' | 'testimonial' | 'overview';
  as?: 'article' | 'div';
  border?: boolean;
  surface?: 'light' | 'dark';
}

const {
  variant = 'feature',
  as = 'article',
  border = true,
  surface = 'light',
  class: className,
  className: classNameProp,
  ...rest
} = Astro.props;

const Tag = as;
const surfaceClass = surface === 'light' ? 'bg-white' : 'bg-gray-90 text-base-lightest';
const borderClass = border && (surface === 'light' ? 'border border-base-lighter' : 'border border-base-darkest');

const classes = [
  'card',
  `card--${variant}`,
  'radius-lg',
  surfaceClass,
  'width-full',
  borderClass,
  variant === 'dataset' && 'overflow-hidden',
  ['feature', 'panel', 'testimonial', 'overview'].includes(variant) &&
    'padding-2',
  className,
  classNameProp,
]
  .filter(Boolean)
  .join(' ');
---

<Tag class={classes} {...rest}>
  <slot />
</Tag>
