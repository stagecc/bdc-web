---
interface Props {
  text: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  class?: string;
}

const { text, position = 'top', class: className } = Astro.props;
---

<button
  type="button"
  class={className}
  title={text}
  data-position={position}
  aria-label={text}
>
  <slot />
</button>
