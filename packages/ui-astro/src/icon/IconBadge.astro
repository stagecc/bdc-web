---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  tone?: 'secondary' | 'cool' | 'warm' | 'neutral';
  variant?: 'inline' | 'medium' | 'feature' | 'feature-lg';
  size?: 3 | 4 | 5 | 6 | 7 | 8 | 9;
  iconSize?: 3 | 4 | 5 | 6 | 7;
  label?: string;
  class?: string;
}

const {
  icon,
  tone = 'secondary',
  variant = 'inline',
  size,
  iconSize,
  label,
  class: className,
} = Astro.props;

const toneClasses = {
  secondary: 'bg-secondary-lighter text-secondary-dark',
  cool: 'bg-accent-cool-lighter text-accent-cool-darker',
  warm: 'bg-accent-warm-lighter text-accent-warm-darker',
  neutral: 'bg-base-lightest text-base-dark',
} as const;

const sizeByVariant = {
  inline: 4,
  medium: 6,
  feature: 8,
  'feature-lg': 9,
} as const;

const iconSizeByBadgeSize = {
  3: 3,
  4: 3,
  5: 3,
  6: 4,
  7: 4,
  8: 5,
  9: 5,
} as const;

const resolvedSize = size ?? sizeByVariant[variant];
const resolvedIconSize = iconSize ?? iconSizeByBadgeSize[resolvedSize];

const sizeClass = `height-${resolvedSize} width-${resolvedSize}`;
---

<span
  class:list={[
    'radius-pill flex-shrink-0 display-inline-flex flex-justify-center flex-align-center',
    toneClasses[tone],
    sizeClass,
    className,
  ]}
  style="aspect-ratio: 1;"
>
  <Icon name={icon} size={resolvedIconSize} label={label} />
</span>
