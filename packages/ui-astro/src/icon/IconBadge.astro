---
import Icon from './Icon.astro';

interface Props {
  icon: string;
  tone?: 'secondary' | 'cool' | 'warm' | 'neutral';
  size?: 3 | 4 | 5 | 6;
  iconSize?: 3 | 4 | 5;
  label?: string;
  class?: string;
}

const {
  icon,
  tone = 'secondary',
  size = 4,
  iconSize = 3,
  label,
  class: className,
} = Astro.props;

const toneClasses = {
  secondary: 'bg-secondary-lighter text-secondary-dark',
  cool: 'bg-accent-cool-lighter text-accent-cool-darker',
  warm: 'bg-accent-warm-lighter text-accent-warm-darker',
  neutral: 'bg-base-lightest text-base-dark',
} as const;

const sizeClass = `height-${size} width-${size}`;
---

<span
  class:list={[
    'radius-pill flex-shrink-0 display-inline-flex flex-justify-center flex-align-center padding-05',
    toneClasses[tone],
    sizeClass,
    className,
  ]}
>
  <Icon name={icon} size={iconSize} label={label} />
</span>
