---
import Button from '../button/Button.astro';

interface HeroCta {
  label: string;
  href: string;
  variant?: 'default' | 'secondary' | 'accent-cool' | 'accent-warm' | 'base' | 'outline' | 'outline-inverse' | 'inverse' | 'unstyled';
}

interface Props {
  eyebrow?: string;
  title?: string;
  titleLines?: string[];
  description: string;
  primaryCta?: HeroCta;
  secondaryCta?: HeroCta;
  tone?: 'light' | 'dark';
  image?: string;
  ariaLabel?: string;
}

const {
  eyebrow,
  title,
  titleLines,
  description,
  primaryCta,
  secondaryCta,
  tone = 'light',
  image,
  ariaLabel = 'Introduction',
} = Astro.props;
const hasCustomVisual = Astro.slots.has('visual');
const hasTitleLines = Array.isArray(titleLines) && titleLines.length > 0;
---

<section
  class:list={[
    'layout-hero',
    tone === 'dark' && 'layout-hero--dark',
    image && 'layout-hero--image',
  ]}
  aria-label={ariaLabel}
  style={image ? `--hero-bg: linear-gradient(rgb(10 34 71 / 62%), rgb(10 34 71 / 62%)), url(${image})` : undefined}
>
  <div class="grid-container layout-hero__inner">
    <div class="layout-hero__content">
      {
        eyebrow && (
          <p class="layout-hero__eyebrow text-uppercase text-bold text-ls-2 font-sans-2xs margin-top-3 margin-bottom-1">{eyebrow}</p>
        )
      }
      <h1 class="margin-0">
        {hasTitleLines
          ? titleLines.map((line) => <span class="display-block">{line}</span>)
          : title}
      </h1>
      <p class="layout-hero__lede line-height-sans-5">{description}</p>
      {
        (primaryCta || secondaryCta) && (
          <div class="layout-hero__actions display-flex flex-wrap gap-2">
            {primaryCta && <Button to={primaryCta.href} variant={primaryCta.variant ?? 'default'}>{primaryCta.label}</Button>}
            {
              secondaryCta && (
                <Button to={secondaryCta.href} variant={secondaryCta.variant ?? 'outline'}>
                  {secondaryCta.label}
                </Button>
              )
            }
          </div>
        )
      }
    </div>

    {
      (hasCustomVisual || !image) && (
        <div class="layout-hero__visual" aria-hidden="true">
          {
            hasCustomVisual ? (
              <slot name="visual" />
            ) : (
              <div class="layout-hero__screen">
                <div class="layout-hero__screen-toolbar"></div>
                <div class="layout-hero__screen-content">
                  <div class="layout-hero__chart layout-hero__chart--scatter"></div>
                  <div class="layout-hero__chart layout-hero__chart--heatmap"></div>
                </div>
                <div class="layout-hero__screen-footer"></div>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</section>

<style lang="scss">
  @use "@bdc/uswds-theme/src/uswds-init" as core;

  $brand-900: core.core-color(core.$theme-color-primary-darker);
  $brand-700: core.core-color(core.$theme-color-primary);
  $copy: core.core-color("blue-70");
  $border-soft: core.core-color("blue-10");
  $dark-copy: core.core-color("blue-5");
  $dark-heading: core.core-color("white");

  .layout-hero {
    background:
      radial-gradient(circle at 85% 15%, rgb(86 149 255 / 35%) 0%, transparent 35%),
      linear-gradient(120deg, #f7fbff 0%, #e7f0ff 48%, #d6e7ff 100%);
    border-bottom: 1px solid $border-soft;
    padding: 4.5rem 0 2.5rem;
  }

  .layout-hero--dark {
    background:
      radial-gradient(circle at 14% 20%, rgb(114 192 255 / 26%) 0%, transparent 35%),
      radial-gradient(circle at 78% 28%, rgb(236 89 122 / 22%) 0%, transparent 34%),
      linear-gradient(135deg, #091f45 0%, #0a2b61 45%, #123f83 100%);
    border-bottom-color: rgb(255 255 255 / 14%);
  }

  .layout-hero--dark .layout-hero__content h1 {
    color: $dark-heading;
    text-shadow: 0 8px 24px rgb(7 24 53 / 40%);
  }

  .layout-hero--dark .layout-hero__eyebrow {
    color: #93d8ff;
  }

  .layout-hero--dark .layout-hero__lede {
    color: $dark-copy;
  }

  .layout-hero--image {
    background-image: var(--hero-bg);
    background-position: center;
    background-size: cover;
  }

  .layout-hero--image .layout-hero__content h1,
  .layout-hero--image .layout-hero__eyebrow,
  .layout-hero--image .layout-hero__lede {
    color: #fff;
  }

  .layout-hero__inner {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
  }

  .layout-hero__content h1 {
    color: $brand-900;
    font-size: clamp(3.1rem, 4.3vw, 5rem);
    line-height: 1.2;
    max-width: unset;
  }

  .layout-hero__eyebrow {
    color: $brand-700;
  }

  .layout-hero__lede {
    color: $copy;
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    margin: 1.2rem 0 1.8rem;
    max-width: 62ch;
  }

  .layout-hero__actions {
    gap: 0.85rem;
  }

  .layout-hero__visual {
    align-items: center;
    display: flex;
    justify-content: center;
    min-height: 300px;
  }

  .layout-hero__screen {
    background: #fefefe;
    border-radius: 18px;
    box-shadow: 0 30px 60px -35px rgb(7 38 87 / 80%);
    max-width: 560px;
    overflow: hidden;
    padding: 0.85rem;
    transform: perspective(1200px) rotateY(-8deg) rotateX(4deg);
    width: 100%;
  }

  .layout-hero--dark .layout-hero__screen {
    background: linear-gradient(180deg, rgb(20 52 99 / 78%) 0%, rgb(16 44 86 / 82%) 100%);
    border: 1px solid rgb(164 205 255 / 28%);
    box-shadow: 0 26px 58px -34px rgb(2 12 28 / 92%);
  }

  .layout-hero--dark .layout-hero__screen-toolbar,
  .layout-hero--dark .layout-hero__screen-footer {
    background: linear-gradient(90deg, rgb(149 206 255 / 30%) 0%, rgb(131 193 255 / 14%) 100%);
  }

  .layout-hero--dark .layout-hero__chart--scatter {
    background:
      radial-gradient(circle at 12% 82%, rgb(255 108 128 / 44%) 0%, transparent 42%),
      radial-gradient(circle at 70% 42%, rgb(76 155 255 / 42%) 0%, transparent 45%),
      linear-gradient(135deg, #1c4478, #295592);
  }

  .layout-hero--dark .layout-hero__chart--heatmap {
    background:
      radial-gradient(circle at 22% 22%, rgb(124 243 255 / 34%) 0%, transparent 34%),
      radial-gradient(circle at 78% 74%, rgb(109 141 255 / 36%) 0%, transparent 44%),
      linear-gradient(135deg, #1a4e83, #2f6298);
  }

  .layout-hero__screen-toolbar,
  .layout-hero__screen-footer {
    background: linear-gradient(90deg, #e2ecfd 0%, #f4f8ff 100%);
    border-radius: 10px;
    height: 1.05rem;
  }

  .layout-hero__screen-content {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0.85rem 0;
    min-height: 180px;
  }

  .layout-hero__chart {
    border-radius: 14px;
    min-height: 180px;
  }

  .layout-hero__chart--scatter {
    background:
      radial-gradient(circle at 12% 82%, rgb(255 89 104 / 45%) 0%, transparent 38%),
      radial-gradient(circle at 70% 42%, rgb(36 118 255 / 38%) 0%, transparent 40%),
      linear-gradient(135deg, #eef5ff, #ffffff);
  }

  .layout-hero__chart--heatmap {
    background:
      radial-gradient(circle at 22% 22%, rgb(128 230 255 / 44%) 0%, transparent 30%),
      radial-gradient(circle at 78% 74%, rgb(54 85 255 / 42%) 0%, transparent 38%),
      linear-gradient(135deg, #e8f1ff, #f8fbff);
  }

  @media (min-width: 64em) {
    .layout-hero__inner {
      align-items: center;
      grid-template-columns: 1fr minmax(320px, 42%);
    }

    .layout-hero {
      padding-top: 6.2rem;
    }

    .layout-hero__content h1 {
      font-size: clamp(2.1rem, 4.3vw, 3.5rem);
      max-width: 18ch;
    }

    .layout-hero--image .layout-hero__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
