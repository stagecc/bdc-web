---
interface Props {
  variant: 'info' | 'warning' | 'success' | 'error' | 'emergency';
  slim?: boolean;
  noIcon?: boolean;
  heading?: string;
  headingLevel?: 2 | 3 | 4;
}

const DEFAULT_HEADINGS: Record<Props['variant'], string> = {
  info: 'Information',
  warning: 'Warning',
  success: 'Success',
  error: 'Error',
  emergency: 'Emergency',
};

const {
  variant,
  slim = false,
  noIcon = false,
  heading = DEFAULT_HEADINGS[variant],
  headingLevel = 3,
} = Astro.props;

const classes = [
  'usa-alert',
  `usa-alert--${variant}`,
  'margin-y-3',
  slim && 'usa-alert--slim',
  noIcon && 'usa-alert--no-icon',
]
  .filter(Boolean)
  .join(' ');

const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
const headingId = `inline-alert-heading-${crypto.randomUUID()}`;
---

<section class={classes} aria-labelledby={headingId}>
  <div class="usa-alert__body">
    <Heading id={headingId} class="usa-alert__heading">{heading}</Heading>
    <div class="usa-alert__text">
      <slot />
    </div>
  </div>
</section>