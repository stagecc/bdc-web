---
import Tag from '@bdc/ui-astro/tag/Tag.astro';
import SearchResultBreadcrumb from './SearchResultBreadcrumb.astro';
---

<template id="search-result-badge-news-template">
  <Tag label="News" tone="warm" />
</template>
<template id="search-result-badge-event-template">
  <Tag label="Event" tone="cool" />
</template>
<template id="search-result-badge-page-template">
  <Tag label="Page" tone="secondary" />
</template>
<template id="search-result-breadcrumb-template">
  <SearchResultBreadcrumb />
</template>
