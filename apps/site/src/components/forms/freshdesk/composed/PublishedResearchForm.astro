---
import InlineAlert from '@bdc/ui-astro/alert/InlineAlert.astro';
import { getCustomObjectSchema } from '../../../../util/freshdesk/getCustomObjectSchema';
import type { CustomObjectField } from '../../../../util/freshdesk/typesCustomObjects';
import { formMessages } from '../../util/errorMessages';
import DynamicCustomObjectForm from '../form-types/DynamicCustomObjectForm.tsx';

let fields: CustomObjectField[] = [];
let primaryFieldName = 'name';
let formError = false;
const hasFreshdeskAuth =
  Boolean(import.meta.env.FRESHDESK_DOMAIN) &&
  Boolean(import.meta.env.FRESHDESK_API_KEY);
const schemaIdRaw = import.meta.env
  .FRESHDESK_CUSTOM_OBJECT_PUBLICATIONS_SCHEMA_ID;

const schemaId = Number(schemaIdRaw);

if (!hasFreshdeskAuth || !schemaIdRaw || Number.isNaN(schemaId)) {
  console.warn(
    'Skipping publication submission schema fetch: missing Freshdesk credentials or schema ID.',
  );
  formError = true;
} else {
  try {
    const schema = await getCustomObjectSchema(schemaId);
    fields = schema.fields;
    primaryFieldName = schema.primaryFieldName;
  } catch (e) {
    console.error('Failed to fetch publication submission form config:', e);
    formError = true;
  }
}
---

<InlineAlert variant="warning" heading="Temporary Notice">
  This form is currently being updated. Submission may be temporarily unavailable, so please try again later if needed.
</InlineAlert>

<DynamicCustomObjectForm
  fields={fields}
  primaryFieldName={primaryFieldName}
  schemaId={schemaId}
  idPrefix="PUB"
  messages={formMessages.publishedResearch}
  submitUrl={import.meta.env.FRESHDESK_PROXY_URL}
  recaptchaSiteKey={import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}
  error={formError}
  client:visible
/>
