---
import InlineAlert from '@bdc/ui-astro/alert/InlineAlert.astro';
import { getFormFields } from '../../../../util/freshdesk/getFormFields';
import type { FreshdeskField } from '../../../../util/freshdesk/types';
import { formMessages } from '../../util/errorMessages';
import DynamicForm from '../form-types/DynamicForm.tsx';

let fields: FreshdeskField[] = [];
let formError = false;
const hasFreshdeskAuth =
  Boolean(import.meta.env.FRESHDESK_DOMAIN) &&
  Boolean(import.meta.env.FRESHDESK_API_KEY);
const formId = import.meta.env.FRESHDESK_FORM_GET_HELP;

if (!hasFreshdeskAuth || !formId) {
  console.warn(
    'Skipping get help form field fetch: missing Freshdesk credentials or form ID.',
  );
  formError = true;
} else {
  try {
    fields = await getFormFields(formId);
  } catch (e) {
    console.error('Failed to fetch get help form fields:', e);
    formError = true;
  }
}
---

<InlineAlert variant="warning" heading="Temporary Notice">
  This form is currently being updated. Submission may be temporarily unavailable, so please try again later if needed.
</InlineAlert>

<DynamicForm
  fields={fields}
  formType="Get Help"
  messages={formMessages.getHelp}
  submitUrl={import.meta.env.FRESHDESK_PROXY_URL}
  recaptchaSiteKey={import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}
  error={formError}
  client:load
/>
