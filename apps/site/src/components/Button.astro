---
import SharedButton from '@bdc/ui-astro/button/Button.astro';

interface Props extends astroHTML.JSX.ButtonHTMLAttributes {
  variant?:
    | 'default'
    | 'secondary'
    | 'accent-cool'
    | 'accent-warm'
    | 'base'
    | 'outline'
    | 'outline-inverse'
    | 'inverse'
    | 'unstyled';
  size?: 'default' | 'big';
  icon?: string;
  href?: string;
  to?: string;
  centered?: boolean;
}

const props = Astro.props as Props;
---

<SharedButton {...props}><slot /></SharedButton>
