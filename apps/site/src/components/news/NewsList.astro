---
import Card from '@bdc/ui-astro/card/Card.astro';
import Tag from '@bdc/ui-astro/tag/Tag.astro';
import Link from '@components/link/Link.astro';

const { items } = Astro.props;
---
<ul class="usa-list usa-list--unstyled">
  {items.map((post) => (
    <li>
      <Card class="display-flex flex-column flex-align-start height-full margin-bottom-2">
        <Tag label={post.data.updateType} tone="neutral" />
        <h3 class="margin-y-1 font-heading-md">
          <Link to={`/news/latest-updates/${post.id}/`}>
            {post.data.title}
          </Link>
        </h3>

        <time datetime={post.data.date.toISOString()} class="display-block font-sans-2xs text-base-dark margin-bottom-1">
          {post.data.date.toLocaleDateString('en-US', {
            month: 'long',
            day: 'numeric',
            year: 'numeric'
          })}
        </time>

        <p class="margin-top-0 margin-bottom-1">{post.data.excerpt}</p>

        {post.data.tags.length > 0 && (
          <div class="display-flex flex-wrap flex-align-center margin-bottom-1">
            <span class="margin-right-05 font-sans-2xs text-base-dark">Topics:</span>
            {post.data.tags.map((tag) => (
              <Link to={`/tagged/${tag}`} class="margin-right-05 margin-bottom-05 text-no-underline">
                <Tag label={tag} tone="warm" />
              </Link>
            ))}
          </div>
        )}

        <p class="margin-top-auto margin-bottom-0 width-full text-right">
          <Link to={`/news/latest-updates/${post.id}/`}>
            Read Article
          </Link>
        </p>
      </Card>
    </li>
  ))}
</ul>
