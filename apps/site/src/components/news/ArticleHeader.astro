---
const { title, date, updateType, tags = [] } = Astro.props;

import Link from '@bdc/ui-astro/link/Link.astro';
import Tag from '@bdc/ui-astro/tag/Tag.astro';
---

<header class="article__header">

  <span class="usa-tag">
    {updateType}
  </span>

  <h1>{title}</h1>
  <div class="display-flex flex-align-center">
    <time datetime={date.toISOString()} class="text-base-dark">
      Published on {date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </time>
  </div>

  <div class="display-flex flex-justify flex-align-center border-bottom">
    
    {tags.length > 0 && (
      <div class="tags display-flex padding-0 margin-y-1">
        {tags.map((tag) => (
          <Link to={`/tagged/${tag}`} class="margin-right-05 margin-bottom-05 text-no-underline">
            <Tag label={tag} tone="neutral" />
          </Link>
        ))}
      </div>
    )}
  </div>
</header>
