---
import { Image } from 'astro:assets';
import Button from '@bdc/ui-astro/button/Button.astro';
import CardCta from '@bdc/ui-astro/card/CardCta.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import nhlbiLogo from '../../assets/NHLBI-logo.svg';

// __BUILD_DATE__ / __BUILD_YEAR__ are pinned to America/New_York at build
// time — see vite.define in astro.config.mjs.
const year = __BUILD_YEAR__;
---

<footer class="usa-footer usa-footer--medium" data-analytics-section="footer">
  <div class="usa-footer__primary-section bg-base-darker border-top border-bottom border-base-dark">
    <div class="grid-container">
      <div class="grid-row">
        <div class="desktop:grid-col-9 display-flex">
          <nav class="usa-footer__nav width-full padding-left-0" aria-label="Footer navigation">
            <div class="grid-row grid-gap-2 desktop:grid-gap-4 height-full">
              <div class="mobile-lg:grid-col-6 tablet:grid-col-3 desktop:grid-col-3 margin-bottom-3 desktop:margin-bottom-0 minw-0 desktop:border-left desktop:border-base-dark ">
                <section class="usa-footer__primary-content overflow-wrap-anywhere text-base-lighter">
                  <h3 class="usa-footer__primary-link margin-bottom-105 text-base-lightest font-ui-2xs text-uppercase">Data</h3>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/data/analyze">Analyze</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/data/explore">Explore</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/data/share">Share</Link></li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 tablet:grid-col-3 desktop:grid-col-3 margin-bottom-3 desktop:margin-bottom-0 minw-0 desktop:border-left desktop:border-base-dark desktop:padding-left-2">
                <section class="usa-footer__primary-content overflow-wrap-anywhere text-base-lighter">
                  <h3 class="usa-footer__primary-link margin-bottom-105 text-base-lightest font-ui-2xs text-uppercase">News</h3>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/news/latest-updates">Updates</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/news/bdc-enabled-research">Research</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/news/events">Events</Link></li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 tablet:grid-col-3 desktop:grid-col-3 margin-bottom-3 desktop:margin-bottom-0 minw-0 desktop:border-left desktop:border-base-dark desktop:padding-left-2">
                <section class="usa-footer__primary-content overflow-wrap-anywhere text-base-lighter">
                  <h3 class="usa-footer__primary-link margin-bottom-105 text-base-lightest font-ui-2xs text-uppercase">About</h3>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/about/bdc">About BDC</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/about/interoperability">Interoperability</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/about/research-communities">Communities</Link></li>
                  </ul>
                </section>
              </div>
              <div class="mobile-lg:grid-col-6 tablet:grid-col-3 desktop:grid-col-3 margin-bottom-3 desktop:margin-bottom-0 minw-0 desktop:border-left desktop:border-right desktop:border-base-dark desktop:padding-left-2">
                <section class="usa-footer__primary-content overflow-wrap-anywhere text-base-lighter">
                  <h3 class="usa-footer__primary-link margin-bottom-105 text-base-lightest font-ui-2xs text-uppercase">Connect</h3>
                  <ul class="usa-list usa-list--unstyled">
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/help/contact-and-support">Contact Us</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="/help/get-help">Get Help</Link></li>
                    <li class="usa-footer__secondary-link margin-bottom-1 line-height-body-4 hover:text-base-lightest"><Link inheritColor to="https://www.youtube.com/@nhlbibiodatacatalyst8024">Youtube</Link></li>
                  </ul>
                </section>
              </div>
            </div>
          </nav>
        </div>

        <div class="desktop:grid-col-3 desktop:padding-y-3 tablet:padding-left-3">
          <CardCta
            icon="campaign"
            title="Stay Informed"
            text="Get the latest BDC updates and news in your inbox."
            href="/support/contact"
            cta="Sign Up"
            border
          />
        </div>
      </div>
    </div>
  </div>

  <!--
    USWDS agency identifier block.
    Pattern: https://designsystem.digital.gov/components/identifier/
  -->
  <div class="usa-identifier">
    <section
      class="usa-identifier__section usa-identifier__section--masthead"
      aria-label="Agency identifier"
    >
      <div class="usa-identifier__container">
        <section
          class="usa-identifier__identity"
          aria-label="Agency description"
        >
          <p class="usa-identifier__identity-domain">biodatacatalyst.nhlbi.nih.gov</p>
          <p class="usa-identifier__identity-disclaimer">
            An official website of the
            <Link to="https://www.nhlbi.nih.gov/">National Heart, Lung, and Blood Institute (NHLBI)</Link>
            at the
            <Link to="https://www.nih.gov/">National Institutes of Health (NIH)</Link>,
            part of the
            <Link to="https://www.hhs.gov/">U.S. Department of Health &amp; Human Services</Link>.
          </p>
        </section>
      </div>
    </section>

    <nav
      class="usa-identifier__section usa-identifier__section--required-links"
      aria-label="Important links"
    >
      <div class="usa-identifier__container">
        <ul class="usa-identifier__required-links-list">
          <li class="usa-identifier__required-links-item">
            <Link to="/accessibility" class="usa-identifier__required-link">Accessibility</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="/privacy" class="usa-identifier__required-link">Privacy policy</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://www.nhlbi.nih.gov/about" class="usa-identifier__required-link">About NHLBI</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://www.nih.gov/institutes-nih/nih-office-director/office-communications-public-liaison/freedom-information-act-office" class="usa-identifier__required-link">FOIA requests</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://www.hhs.gov/about/agencies/asa/eeo/no-fear-act/index.html" class="usa-identifier__required-link">No FEAR Act data</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://oig.hhs.gov/" class="usa-identifier__required-link">Office of the Inspector General</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://www.hhs.gov/about/budget/index.html" class="usa-identifier__required-link">Performance reports</Link>
          </li>
          <li class="usa-identifier__required-links-item">
            <Link to="https://www.hhs.gov/vulnerability-disclosure-policy/index.html" class="usa-identifier__required-link">Vulnerability disclosure</Link>
          </li>
        </ul>
      </div>
    </nav>

    <section
      class="usa-identifier__section usa-identifier__section--usagov"
      aria-label="U.S. government information and services"
    >
      <div class="usa-identifier__container">
        <div class="usa-identifier__usagov-description">
          Looking for U.S. government information and services?
        </div>
        <a href="https://www.usa.gov/" class="usa-link">Visit USA.gov</a>
      </div>
    </section>

    <div class="grid-container display-flex flex-justify font-ui-3xs text-base-light">
      <div>
        &copy; {year} NHLBI BioData Catalyst <sup>&reg;</sup>
      </div>
      <div>
        Site last updated {__BUILD_DATE__}.
      </div>
    </div>
  </div>
</footer>
