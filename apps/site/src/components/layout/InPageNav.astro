<!--
  Custom In-Page Navigation (replaces @trussworks/react-uswds InPageNavigation)

  The trussworks InPageNavigation component expects a React JSX tree as its
  `content` prop and walks the virtual DOM to extract headings. This is
  incompatible with Astro content collections, where Markdown is rendered
  server-side into HTML — there is no React element tree to traverse.

  Using the trussworks component would require client-hydrating the entire
  page body as React, sacrificing Astro's zero-JS-by-default static output.

  Instead, this Astro component:
    - Outputs the standard USWDS in-page-nav container markup
    - Uses the USWDS in-page-navigation JavaScript module client-side
    - Passes behavior config through USWDS data attributes (for example
      `data-root-margin`, `data-threshold`, and heading selectors)

  This preserves the project's architecture rule that USWDS CSS is consumed
  globally, keeps content server-rendered, and avoids pulling React into a
  layout concern that doesn't need interactivity beyond scroll tracking.
-->

---
import Button from '@bdc/ui-astro/button/Button.astro';

interface Props {
  title?: string;
}

const { title = 'On this page' } = Astro.props;
---

<div class="usa-in-page-nav-container">
  <aside
    class="usa-in-page-nav display-flex flex-column"
    data-analytics-section="in_page_nav"
    data-title-text={title}
    data-heading-elements="h2 h3"
    data-main-content-selector=".usa-in-page-nav-container .usa-prose"
    data-root-margin="-100px 0px -60% 0px"
    data-threshold="1"
    data-scroll-offset="110"
  >
    <Button
      href="#main-content"
      variant="outline"
      class="in-page-nav__back-to-top order-2 margin-top-8 margin-bottom-0 margin-x-auto"
    >↑ Back to top</Button>
  </aside>
  <div class="usa-prose">
    <slot />
  </div>
</div>

<style>
  .usa-in-page-nav {
    min-width: 240px;
  }

  .usa-in-page-nav > :global(:not(.in-page-nav__back-to-top)) {
    order: 1;
  }

  .usa-prose :global(:is(h2, h3)) {
    scroll-margin-top: 120px;
  }

  .in-page-nav__back-to-top {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(0.5rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }

  .in-page-nav__back-to-top.in-page-nav__back-to-top--visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .in-page-nav__back-to-top,
    .in-page-nav__back-to-top.in-page-nav__back-to-top--visible {
      transition: none;
    }
  }
</style>

<script>
  import inPageNavigation from '@uswds/uswds/js/usa-in-page-navigation';

  const BACK_TO_TOP_VISIBLE_CLASS = 'in-page-nav__back-to-top--visible';
  const getBackToTopRevealOffset = () => Math.max(320, Math.round(window.innerHeight * 0.6));

  const initInPageNavController = (root = document.body) => {
    const backToTopButtons = Array.from(
      root.querySelectorAll('a.in-page-nav__back-to-top')
    );

    const updateBackToTopVisibility = () => {
      const shouldShow = window.scrollY >= getBackToTopRevealOffset();

      for (const button of backToTopButtons) {
        button.classList.toggle(BACK_TO_TOP_VISIBLE_CLASS, shouldShow);
      }
    };

    const onBackToTopClick = (event) => {
      const trigger = event.target.closest('a.in-page-nav__back-to-top');
      if (!trigger) {
        return;
      }

      const href = trigger.getAttribute('href');
      if (!href?.startsWith('#')) {
        return;
      }

      const target = document.querySelector(href);
      if (!target) {
        return;
      }

      event.preventDefault();
      const behavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches
        ? 'auto'
        : 'smooth';
      target.scrollIntoView({ behavior, block: 'start' });
      history.replaceState(null, '', href);
    };

    root.addEventListener('click', onBackToTopClick);
    window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
    window.addEventListener('resize', updateBackToTopVisibility);

    updateBackToTopVisibility();

    inPageNavigation.off(root);
    inPageNavigation.on(root);

    return () => {
      root.removeEventListener('click', onBackToTopClick);
      window.removeEventListener('scroll', updateBackToTopVisibility);
      window.removeEventListener('resize', updateBackToTopVisibility);
      inPageNavigation.off(root);
    };
  };

  let cleanup = initInPageNavController();

  document.addEventListener('astro:after-swap', () => {
    cleanup();
    cleanup = initInPageNavController();
  });
</script>
