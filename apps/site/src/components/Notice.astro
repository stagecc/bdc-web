---
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';

interface Props {
  icon: string;
  tone?: 'secondary' | 'cool' | 'warm' | 'neutral';
  variant?: 'inline' | 'compact' | 'medium' | 'feature';
  class?: string;
}

const {
  icon,
  tone = 'secondary',
  variant = 'inline',
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'display-flex flex-justify-center flex-align-center text-base-darkest margin-top-2 margin-bottom-0',
    className,
  ]}
>
  <IconBadge icon={icon} tone={tone} variant={variant} class="margin-right-1" />
  <span>
    <slot />
  </span>
</div>
