---
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';

interface Props {
  icon: string;
  tone?: 'secondary' | 'cool' | 'warm' | 'neutral';
  variant?: 'inline' | 'medium' | 'feature' | 'feature-lg';
  size?: 3 | 4 | 5 | 6 | 7 | 8 | 9;
  iconSize?: 3 | 4 | 5 | 6 | 7;
  class?: string;
}

const {
  icon,
  tone = 'secondary',
  variant = 'inline',
  size,
  iconSize,
  class: className,
} = Astro.props;
---

<div
  class:list={[
    'display-flex flex-justify-center flex-align-center text-base-darkest margin-top-2 margin-bottom-0',
    className,
  ]}
>
  <IconBadge icon={icon} tone={tone} variant={variant} size={size} iconSize={iconSize} class="margin-right-1" />
  <span>
    <slot />
  </span>
</div>
