---
import type { CollectionEntry } from 'astro:content';
import Button from '@components/Button.astro';
import CalendarDate from '@components/events/CalendarDate.astro';
import Icon from '@components/Icon.astro';
import TagLink from '@components/link/TagLink.astro';
import bdcLogo from '../../../public/favicon.svg';

interface Props {
  items: {
    event: CollectionEntry<'events'>;
  }[];
}

const { items } = Astro.props;
---

<ul class="usa-collection">
  {items.map(({ event }) => {
    const {
      title,
      date,
      end_date,
      time,
      eventType,
      location,
      url,
      tags,
      externalEvent,
      excerpt,
      registration_required,
    } = event.data;

    const isPast = (end_date ?? date) < new Date();

    return (
      <li class="usa-collection__item maxw-none">

        <CalendarDate date={date} endDate={end_date} />

        <div class="usa-collection__body">
          <div class="display-flex flex-row flex-align-start">

            <div class="flex-shrink-0 margin-right-1" style="width: 24px;">
              {!externalEvent && (
                <img
                  src={bdcLogo.src}
                  alt="bdc-hosted event"
                  width="24"
                  height="24"
                  class="radius-pill border-1px border-base-lighter"
                />
              )}
            </div>

            <div class="display-flex minw-none">

              <div class="display-flex flex-align-center margin-bottom-05">
                <h4 class="usa-collection__heading margin-0">
                  <a href={`/news/events/${event.id}/`} class="usa-link">
                    {title}
                  </a>
                </h4>
                {eventType && (
                  <span class="usa-tag margin-left-3">{eventType}</span>
                )}
              </div>

              <ul class="usa-collection__meta">

                <li class="usa-collection__meta-item display-flex flex-align-center">
                  <Icon name="calendar_today" size={3}/>
                  <span class="margin-left-1">
                    {date.toLocaleDateString('en-US', {
                      weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
                    })}
                    {end_date && ` – ${end_date.toLocaleDateString('en-US', {
                      weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
                    })}`}
                    {time && <> &middot; {time}</>}
                  </span>
                </li>

                {location && (
                  <li class="usa-collection__meta-item display-flex flex-align-center">
                    <Icon name="location_on" size={3}/>
                    <span class="margin-left-1">{location}</span>
                  </li>
                )}

                {tags?.length > 0 && (
                  <li class="usa-collection__meta-item">
                    <div class="display-flex flex-wrap">
                      {tags.map((tag: string) => (
                        <span class="margin-right-05">
                          <TagLink tag={tag} />
                        </span>
                      ))}
                    </div>
                  </li>
                )}

              </ul>

              {excerpt && (
                <p class="font-sans-xs margin-top-1 margin-bottom-1">
                  {excerpt}
                </p>
              )}

              <div class="display-flex margin-top-2 flex-wrap">
                {url && (!isPast || !registration_required) && (
                  <span class="margin-right-1">
                    <Button href={url} variant="default">
                      {registration_required ? 'Register Now' : 'Event website'}
                    </Button>
                  </span>
                )}
                <Button href={`/news/events/${event.id}/`} variant="outline">
                  View Details
                </Button>
              </div>

            </div>
          </div>
        </div>

      </li>

    );

  })}

</ul>
