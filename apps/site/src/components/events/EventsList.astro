---
import type { CollectionEntry } from 'astro:content';
import Card from '@bdc/ui-astro/card/Card.astro';
import Icon from '@bdc/ui-astro/icon/Icon.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import Tag from '@bdc/ui-astro/tag/Tag.astro';
import BdcHostedIndicator from '@components/events/BdcHostedIndicator.astro';
import CalendarDate from '@components/events/CalendarDate.astro';

interface Props {
  items: (CollectionEntry<'events'> | { event: CollectionEntry<'events'> })[];
}

const { items } = Astro.props;
---

<ul class="add-list-reset margin-0 padding-0">
  {items.map((item) => {
    const event = 'event' in item ? item.event : item;
    const {
      title,
      date,
      end_date,
      time,
      eventType,
      location,
      url,
      tags,
      externalEvent,
      excerpt,
      registration_required,
    } = event.data;

    const isPast = (end_date ?? date) < new Date();

    return (
      <li class="margin-bottom-2">
        <Card variant="panel">
          <div class="grid-row grid-gap-1 tablet:grid-gap-2">
            <div class="tablet:grid-col-auto">
              <CalendarDate date={date} endDate={end_date} />
            </div>
            <div class="tablet:grid-col-fill display-flex flex-column">
              <div class="display-flex flex-wrap flex-align-center flex-justify margin-bottom-1">
                <div class="font-sans-xs text-bold text-base">
                  {date.toLocaleDateString('en-US', {
                    weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
                  })}
                  {end_date && ` - ${end_date.toLocaleDateString('en-US', {
                    weekday: 'long', month: 'long', day: 'numeric', year: 'numeric',
                  })}`}
                </div>
                <div class="display-flex flex-align-center">
                  {eventType && <Tag label={eventType} tone="neutral" class="text-normal margin-left-1" />}
                  {!externalEvent && (
                    <BdcHostedIndicator decorative class="margin-left-1" />
                  )}
                </div>
              </div>

              <div class="display-flex flex-wrap flex-align-center gap-1 margin-bottom-1">
                <h3 class="font-heading-sm tablet:font-heading-md line-height-heading-2 margin-0">
                  <Link to={`/news/events/${event.id}/`} class="text-no-underline hover:text-underline">
                    {title}
                  </Link>
                </h3>
              </div>


              <div>
                {time && (
                  <p class="display-flex flex-align-center margin-0 font-sans-xs text-base-dark maxw-full">
                    <Icon name="schedule" size={2} class="margin-right-05" />
                    {time}
                  </p>
                )}
                {location && (
                  <p class="display-flex flex-align-center margin-0 font-sans-xs text-base-dark maxw-full">
                    <Icon name="location_on" size={2} class="margin-right-05" />
                    {location}
                  </p>
                )}
              </div>

              {excerpt && (
                <p class="font-sans-sm text-base-dark line-height-sans-5 margin-top-1 margin-bottom-1">
                  {excerpt}
                </p>
              )}

              <div class="display-flex margin-top-2 flex-wrap flex-align-center gap-1">
                {tags?.length > 0 && (
                  <div class="display-flex flex-wrap gap-05 margin-right-1">
                    {tags.map((tag: string) => (
                      <Link to={`/tagged/${tag}`} class="text-no-underline hover:text-no-underline">
                        <Tag label={tag} tone="cool" />
                      </Link>
                    ))}
                  </div>
                )}
              </div>

              <div class="display-flex flex-justify margin-top-2 flex-wrap gap-2 flex-align-center">
                {url && (!isPast || !registration_required) && (
                  <Link to={url} class="text-bold">
                    {registration_required ? 'Register now' : 'Event website'}
                  </Link>
                )}
                <Link to={`/news/events/${event.id}/`} class="text-bold">View details &raquo;</Link>
              </div>
            </div>
          </div>
        </Card>
      </li>

    );

  })}

</ul>
