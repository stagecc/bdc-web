---
import Icon from '@bdc/ui-astro/icon/Icon.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import TagPill from '@bdc/ui-astro/tag/TagPill.astro';
import BdcHostedIndicator from '@components/events/BdcHostedIndicator.astro';

const {
  title,
  date,
  endDate,
  time,
  location,
  eventType,
  registration_required,
  url,
  externalEvent = false,
  isPast,
  tags = [],
} = Astro.props;

const dateOptions = { year: 'numeric', month: 'long', day: 'numeric' } as const;
const dateStr = date.toLocaleDateString('en-US', dateOptions);
const endDateStr = endDate?.toLocaleDateString('en-US', dateOptions);
---

<header class="event__header border-bottom border-base-lighter margin-bottom-2 padding-bottom-2">
  {eventType && <TagPill label={eventType} tone="neutral" class="margin-bottom-1" />}

  <h1 class="margin-y-1">{title}</h1>

  <div class="text-base-dark grid-row grid-gap-2">
    <div class="grid-col-12 tablet:grid-col-fill">
      <div class="display-flex flex-align-center margin-bottom-05">
        <Icon name="event" size={3} class="margin-right-05" />
        <time datetime={date.toISOString()}>
          {dateStr}{endDate && ` - ${endDateStr}`}
        </time>
      </div>
      {time && (
        <div class="display-flex flex-align-center margin-bottom-05">
          <Icon name="schedule" size={3} class="margin-right-05" />
          <span>{time}</span>
        </div>
      )}
      {location && (
        <div class="display-flex flex-align-start margin-bottom-05 maxw-full">
          <Icon name="location_on" size={3} class="margin-right-05" />
          <span>{location}</span>
        </div>
      )}
      {tags.length > 0 && (
        <div class="display-flex flex-wrap margin-y-1">
          {tags.map(tag => (
            <Link to={`/tagged/${tag}`} class="text-no-underline hover:text-no-underline margin-right-1">
              <TagPill label={tag} tone="cool" />
            </Link>
          ))}
        </div>
      )}
      {url && (!isPast || !registration_required) && (
        <div class="margin-top-2">
          <Link to={url} class="text-bold">{
            registration_required ? 'Register now' : 'Event website'
          }</Link>
        </div>
      )}
    </div>
    <div class="grid-col-12 tablet:grid-col-auto display-flex flex-align-end margin-top-1 tablet:margin-top-0">
      {!externalEvent && (
        <div class="font-ui-xs display-inline-flex flex-align-center">
          <BdcHostedIndicator decorative size={20} class="margin-right-1" />
          BDC-hosted event
        </div>
      )}
    </div>
  </div>
</header>
