---
import { getCollection } from 'astro:content';
import Button from '@bdc/ui-astro/button/Button.astro';
import CardCopy from '@bdc/ui-astro/card/CardCopy.astro';
import CardCta from '@bdc/ui-astro/card/CardCta.astro';
import Icon from '@bdc/ui-astro/icon/Icon.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import PageSection from '@bdc/ui-astro/layout/PageSection.astro';
import TwoColumnSection from '@bdc/ui-astro/layout/TwoColumnSection.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import HappeningCard from '@components/cards/HappeningCard.astro';
import QuoteCard from '@components/cards/QuoteCard.astro';
import ResearchCommunityCard from '@components/cards/ResearchCommunityCard.astro';
import DugSearchBar from '@components/dug/DugSearchBar';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import YouTubeEmbed from '@components/YouTubeEmbed.astro';
import programs from '@content/programs.json';
import Base from '@layouts/Base.astro';
import homeCoursesImage from '../assets/home-courses.png';
import { slugify } from '../util/slugify';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const programContentEntries = await getCollection('programContent');
const programExcerptById = new Map(
  programContentEntries
    .filter((entry) => Boolean(entry.data.excerpt))
    .map((entry) => [entry.id, entry.data.excerpt]),
);

const upcomingEvents = (await getCollection('events'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .filter((event) => event.data.date >= new Date());

const events = (
  upcomingEvents.length > 0
    ? upcomingEvents
    : (await getCollection('events')).sort(
        (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
      )
).slice(0, 3);

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredPublications = publications
  .slice(0, 2)
  .map((publication) => publication.data);

const defaultCommunityDescription =
  'Approved datasets and tools for this research community.';

const featuredCommunities = programs
  .sort(() => 0.5 - Math.random())
  .slice(0, 4)
  .map((program) => {
    const slug = slugify(program.key);
    return {
      ...program,
      slug,
      excerpt: programExcerptById.get(slug) ?? defaultCommunityDescription,
    };
  });

const testimonials = [
  {
    quote:
      'DESeq2 helped us identify expression changes quickly while keeping our workflow reproducible across teams.',
    person: 'John K.',
    affiliation: 'University of Michigan',
  },
  {
    quote:
      'The STAAR pipeline made variant analyses faster and gave our team confidence in each iteration.',
    person: 'Casey G.',
    affiliation: 'Stanford University',
  },
  {
    quote:
      'BDC workspaces reduced setup time dramatically, so we could focus on interpreting results instead of tooling.',
    person: 'Sam R.',
    affiliation: 'Harvard University',
  },
];

const testimonialTones: Array<'secondary' | 'cool' | 'warm'> = [
  'secondary',
  'cool',
  'warm',
];

const lifecycleSteps = [
  {
    number: '01',
    icon: 'search',
    title: 'Explore data',
    description:
      'Learn where and how to search available studies. No sign-in required to explore.',
    action: {
      label: 'Explore data',
      path: '/data/explor',
    },
  },
  {
    number: '02',
    icon: 'lock_outline',
    title: 'Confirm or request access',
    description:
      'Use your eRA Commons account to access approved datasets or submit a DAR through dbGaP.',
    action: {
      label: 'Check Access',
      path: '/data/check-access',
    },
  },
  {
    number: '03',
    icon: 'assessment',
    title: 'Analyze securely',
    description:
      'Use secure cloud workspaces and tools to analyze data with confidence.',
    action: {
      label: 'Analyze Data',
      path: '/data/analyze',
    },
  },
  {
    number: '04',
    icon: 'local_library',
    title: 'Advance and share research',
    description:
      'Collaborate, reproduce analyses, and publish research outputs.',
    action: {
      label: 'View Research',
      path: '/news/bdc-enabled-research',
    },
  },
];

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const leadNews = news[0];
const secondaryNews = news[1];
const nextEvent = events[0];
---

<Base title="BioData Catalyst">
  <div class="home-page">
    <Hero
      eyebrow="NHLBI BioData Catalyst (BDC)&#174;"
      titleLines={['Explore data.', 'Run analyses.', 'Advance science.']}
      description="BDC brings together NHLBI studies, cloud-based analysis tools, and secure collaborative workspaces to accelerate heart, lung, blood, and sleep research."
      primaryCta={{ label: 'Learn About BDC', href: '/about/bdc', variant: 'accent-warm' }}
      tone="dark"
    />

    <PageSection
      eyebrow="Search Hosted Data"
      title="Discover Data in BDC"
      description="Search by disease, phenotype, biological process, or anatomical entity."
      action={{ label: 'View all data search tools', href: '/data/explore' }}
    >
      <DugSearchBar
        id="home-discover-search"
        placeholder="Try “asthma,” “blood pressure,” or “atrial fibrillation”"
        submitLabel="Search"
        action="/data/explore/dug"
        method="get"
        className="home-discover-search display-flex width-full shadow-2"
      />
    </PageSection>

    <PageSection
      title="Start Your Research Journey"
      description="BDC is a research community where investigators can find, access, store, share, and analyze heart, lung, blood, and sleep data in secure cloud workspaces. As one of NHLBI's data repositories, BDC helps researchers share scientific data, reproduce findings, and reuse trusted resources to accelerate biomedical discovery."
      centered
      tone="muted"
    >
      <div class="margin-top-5 margin-bottom-0 text-center display-flex text-primary-darker flex-align-center flex-justify-center">
        <IconBadge icon="support" tone="warm" size={4} class="margin-right-1" />
        <span class="margin-right-1">Need help with BDC?</span>{' '}
        <Link to="/help/get-help" class="text-bold">
          Submit a request
        </Link>.
      </div>
      <ProcessSteps steps={lifecycleSteps} tone="muted" />
      <div class="display-flex flex-justify-center flex-align-center margin-top-2 margin-bottom-0">
        <IconBadge icon="attach_money" tone="cool" class="margin-right-1" />
        <span>
          Funding may be available for you to get started.&nbsp;
          <Link to="/help/costs" class="text-bold">Learn about usage costs and funding options</Link>.
        </span>
      </div>

      <div
        class="usa-modal-wrapper is-hidden"
        id="home-overview-video-modal"
        data-modal
        data-modal-autoplay-media="true"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="home-overview-video-title"
      >
        <div class="usa-modal-overlay" tabindex="-1">
          <div class="usa-modal usa-modal--lg">
            <div class="usa-modal__content">
              <div class="usa-modal__main">
                <h2 id="home-overview-video-title" class="usa-modal__heading">BDC Two-Minute Overview</h2>
                <YouTubeEmbed id="enWIpA0aJb4" title="BDC two-minute overview" />
              </div>
              <button class="usa-button usa-modal__close" type="button" aria-label="Close video dialog" data-modal-close>
                <Icon name="close" size={4} />
              </button>
            </div>
          </div>
        </div>
      </div>
    </PageSection>

    <PageSection
      eyebrow="Featured Communities"
      title="Explore Data by Research Community"
      action={{ label: 'View all communities', href: '/about/research-communities' }}
      tone="default"
    >
      <div class="grid-row grid-gap-3 margin-bottom-neg-3">
        {featuredCommunities.map((program, index) => (
          <div class="tablet:grid-col-6 desktop:grid-col-6 flex-align-stretch margin-bottom-3">
            <ResearchCommunityCard
              mediaVariant={Math.min(index + 1, 4) as 1 | 2 | 3 | 4}
              title={program.key}
              description={program.excerpt}
              badgeLabel={program.description}
              metric={`${program.doc_count} dataset${program.doc_count === 1 ? '' : 's'}`}
              href={`/about/studies/${program.slug}`}
            />
          </div>
        ))}
      </div>

      <p class="margin-y-2 display-flex flex-justify-center">
        <Link class="text-bold" to="/about/studies">Explore data from all Research Communities</Link>
      </p>
    </PageSection>

    {
      featuredPublications.length > 0 && (
        <PageSection
          eyebrow="Research in Action"
          title="Latest Publications"
          description="Explore the latest BDC-enabled publications and see how investigators are using BDC data and tools to advance heart, lung, blood, and sleep research"
          action={{ label: 'View all publications', href: '/news/bdc-enabled-research' }}
          tone="highlight"
        >
          <div class="display-flex flex-column">
            {featuredPublications.map((publication) => (
              <div class="margin-bottom-2">
                <CardCopy
                  eyebrow="Recent Publication"
                  title={publication.title}
                  description={`Published in ${publication.journalName} on ${dateFormat.format(publication.date)}`}
                  href={publication.url}
                  linkLabel="View Publication"
                />
              </div>
            ))}
          </div>
        </PageSection>
      )
    }

    <TwoColumnSection
      eyebrow="Courses & Training"
      title="BDC for Academic Settings & Trainees"
      description="Use real or synthetic biomedical datasets and cloud-based analysis tools to support courses, workshops, trainee programs, and early-career research development."
      ctaLabel="Explore BDC for Course and Training"
      ctaHref="/about/courses-and-training"
      mediaImage={homeCoursesImage}
      mediaAlt=""
    >
      <div class="display-flex flex-justify-center flex-align-center margin-top-2 margin-bottom-0">
        <IconBadge icon="attach_money" tone="cool" class="margin-right-1" />
        <span>
          Funding may be available for academic use.&nbsp;
          <Link to="/help/costs" class="text-bold">Learn more</Link>.
        </span>
      </div>
    </TwoColumnSection>

    <PageSection
      eyebrow="Latest from BDC"
      title="What's Happening"
      action={{ label:'View all news', href: '/news/latest-updates' }}
      tone="muted"
    >
      <div class="grid-row grid-gap-3 flex-align-stretch">
        <div class="tablet:grid-col-6 margin-bottom-2 tablet:margin-bottom-0">
          {
            leadNews && (
              <HappeningCard
                kind="news"
                lead
                meta={`Published · ${dateFormat.format(leadNews.data.date)}`}
                title={leadNews.data.title}
                summary={leadNews.data.excerpt ?? 'Excerpt not found'}
                href={`/news/latest-updates/${leadNews.id}/`}
                linkLabel="View full update"
              />
            )
          }
        </div>

        <div class="tablet:grid-col-6">
          <div class="display-grid">
            {
              secondaryNews && (
                <div class="margin-bottom-2">
                  <HappeningCard
                    kind="news"
                    meta={`Published · ${dateFormat.format(secondaryNews.data.date)}`}
                    title={secondaryNews.data.title}
                    href={`/news/latest-updates/${secondaryNews.id}/`}
                    linkLabel="View full update"
                  />
                </div>
              )
            }
            {
              nextEvent && (
                <HappeningCard
                  kind="event"
                  meta={`Upcoming · ${dateFormat.format(nextEvent.data.date)}`}
                  title={nextEvent.data.title}
                  href={`/news/events/${nextEvent.id}/`}
                  linkLabel="View event details"
                />
              )
            }
          </div>
        </div>
      </div>
    </PageSection>

    <PageSection
      eyebrow="Researcher Perspectives"
      title="What BDC Researchers Are Saying"
      class="border-top border-bottom border-base-lighter"
      tone="muted"
    >
      <div class="grid-row grid-gap-2">
        {testimonials.map((testimonial, index) => (
          <div class="tablet:grid-col-6 desktop:grid-col-4 margin-bottom-2 desktop:margin-bottom-0">
            <QuoteCard
              quote={testimonial.quote}
              person={testimonial.person}
              affiliation={testimonial.affiliation}
              tone={testimonialTones[index % testimonialTones.length]}
            />
          </div>
        ))}
      </div>
    </PageSection>

    <section class="cta-band padding-y-10">
      <div class="grid-container cta-band__inner display-grid flex-align-center gap-2">
        <div>
          <h2 class="margin-0 text-base-lightest">Ready to Work in BDC?</h2>
          <p class="cta-band__description margin-top-1 margin-bottom-0">
            Find data for your research or begin analyzing in a secure cloud workspace.
          </p>
        </div>
        <div class="usa-button-group margin-y-6">
          <Button to="/data/explore" variant="accent-warm">Explore BDC Data</Button>
          <Button to="/data/analyze" variant="outline-inverse">Start Analyzing</Button>
        </div>
        <div>
          <Link class="text-bold text-base-lightest" inheritColor to="/help/contact-and-support">Get help choosing your next step</Link>
        </div>
      </div>
    </section>
  </div>
</Base>

<style lang="scss">
  .home-page {
    background: linear-gradient(180deg, #f7fbff 0%, #ffffff 30%, #f8fbff 100%);
  }

  .home-discover-search.usa-search,
  .home-discover-search.usa-search--big,
  .home-discover-search .usa-search__form,
  .home-discover-search .usa-input.usa-search__input {
    max-width: none !important;
    width: 100% !important;
  }

  .cta-band {
    background:
      radial-gradient(circle at 10% 20%, rgb(63 122 212 / 42%) 0%, transparent 28%),
      radial-gradient(circle at 86% 26%, rgb(239 158 70 / 30%) 0%, transparent 26%),
      linear-gradient(130deg, #0b3168 0%, #0d4695 100%);
    color: #fff;
  }

  .cta-band__inner {
    grid-template-columns: 1fr;
  }

  .cta-band__description {
    max-width: 58ch;
  }

  @media (min-width: 64em) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
