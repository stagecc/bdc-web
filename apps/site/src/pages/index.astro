---
import { getCollection } from 'astro:content';
import Button from '@bdc/ui-astro/button/Button.astro';
import CardCopy from '@bdc/ui-astro/card/CardCopy.astro';
import CardCta from '@bdc/ui-astro/card/CardCta.astro';
import Icon from '@bdc/ui-astro/icon/Icon.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import PageSection from '@bdc/ui-astro/layout/PageSection.astro';
import TwoColumnSection from '@bdc/ui-astro/layout/TwoColumnSection.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import Blockquote from '@components/Blockquote.astro';
import HappeningCard from '@components/cards/HappeningCard.astro';
import ResearchCommunityCard from '@components/cards/ResearchCommunityCard.astro';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import Notice from '@components/Notice.astro';
import Screenshot from '@components/Screenshot.astro';
import YouTubeEmbed from '@components/YouTubeEmbed.astro';
import programs from '@content/programs.json';
import Base from '@layouts/Base.astro';
import homeCoursesImage from '../assets/bdc-course-photo.png';
import homeHeroGraphic from '../assets/home-hero.png';
import { slugify } from '../util/slugify';
import Card from '@bdc/ui-astro/card/Card.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const programContentEntries = await getCollection('programContent');
const programExcerptById = new Map(
  programContentEntries
    .filter((entry) => Boolean(entry.data.excerpt))
    .map((entry) => [entry.id, entry.data.excerpt]),
);

const upcomingEvents = (await getCollection('events'))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf())
  .filter((event) => event.data.date >= new Date());

const events = (
  upcomingEvents.length > 0
    ? upcomingEvents
    : (await getCollection('events')).sort(
        (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
      )
).slice(0, 3);

const publications = (await getCollection('publications')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const featuredPublications = publications
  .slice(0, 2)
  .map((publication) => publication.data);

const defaultCommunityDescription =
  'Approved datasets and tools for this research community.';

const featuredCommunities = programs
  .sort(() => 0.5 - Math.random())
  .slice(0, 4)
  .map((program) => {
    const slug = slugify(program.key);
    return {
      ...program,
      slug,
      excerpt: programExcerptById.get(slug) ?? defaultCommunityDescription,
    };
  });

const testimonials = await getCollection('testimonials');
const featuredTestimonial =
  testimonials[Math.floor(Math.random() * testimonials.length)]?.data;
const featuredTestimonialAttribution = featuredTestimonial
  ? [
      featuredTestimonial.name,
      featuredTestimonial.title,
      featuredTestimonial.organization,
    ]
      .filter(Boolean)
      .join(', ')
  : undefined;

const lifecycleSteps = [
  {
    number: '01',
    icon: 'search',
    title: 'Explore data',
    description:
      'Search NHLBI studies and explore available variables and datasets before signing in.',
    action: {
      label: 'Explore data',
      path: '/data/explore',
    },
  },
  {
    number: '02',
    icon: 'lock_outline',
    title: 'Confirm or request access',
    description:
      'Use your eRA Commons account to access approved datasets or submit a dbGaP request.',
    action: {
      label: 'Check Access',
      path: '/data/check-access',
    },
  },
  {
    number: '03',
    icon: 'assessment',
    title: 'Analyze securely',
    description:
      'Bring scalable computing to the data and analyze datasets individually or together in secure cloud workspaces.',
    action: {
      label: 'Analyze Data',
      path: '/data/analyze',
    },
  },
  {
    number: '04',
    icon: 'local_library',
    title: 'Advance and share research',
    description:
      'Collaborate, reproduce analyses, and share findings others can build upon.',
    action: {
      label: 'View BDC-Enabled Research',
      path: '/news/bdc-enabled-research',
    },
  },
];

const dateFormat = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

const leadNews = news[0];
const secondaryNews = news[1];
const nextEvent = events[0];
---

<Base title="BioData Catalyst">
  <div class="home-page">
    <Hero
      eyebrow="NHLBI BioData Catalyst&#174; (BDC)"
      titleLines={['Explore data.', 'Run analyses.', 'Advance science.']}
      description="BDC brings together longitudinal studies and rich phenotypic & genomic resources
        so researchers can discover, combine, and analyze data at scale
        without managing complex infrastructure."
      primaryCta={{ label: 'Learn About BDC', href: '/about/bdc', variant: 'accent-warm' }}
      tone="dark"
    >
      <div slot="visual" class="home-hero-visual position-relative width-full maxw-tablet-lg" aria-hidden="true">
        <div class="home-hero-visual__halo home-hero-visual__halo--left"></div>
        <div class="home-hero-visual__halo home-hero-visual__halo--right"></div>
        <Screenshot
          src={homeHeroGraphic.src}
          width={homeHeroGraphic.width}
          height={homeHeroGraphic.height}
          alt=""
          rotateX={15}
          rotateY={29}
        />
      </div>
    </Hero>

    <PageSection
      eyebrow="Why BDC?"
      title="Ask Bigger Questions with NHLBI Data"
      tone="highlight"
    >
      <div class="grid-row grid-gap-4 margin-bottom-4">
        <div class="tablet:grid-col-4 border-top-1px border-accent-cool padding-top-4">
          <h3 class="font-heading-lg margin-top-0">Build on decades of NHLBI research</h3>
          <p class="margin-bottom-0 line-height-sans-4">
            Access well-characterized data from longstanding NHLBI studies and programs.
          </p>
        </div>
        <div class="tablet:grid-col-4 border-top-1px border-accent-cool padding-top-4">
          <h3 class="font-heading-lg margin-top-0">Connect data in new ways</h3>
          <p class="margin-bottom-0 line-height-sans-4">
            Bring together information across studies, cohorts, phenotypes, and genomic resources to ask questions beyond a single dataset.
          </p>
        </div>
        <div class="tablet:grid-col-4 border-top-1px border-accent-cool padding-top-4">
          <h3 class="font-heading-lg margin-top-0">Analyze without building the infrastructure</h3>
          <p class="margin-bottom-0 line-height-sans-4">
            Use secure, scalable cloud environments and reusable analytical resources alongside the data.
          </p>
        </div>
      </div>
    </PageSection>

    <PageSection
      eyebrow="The Data in BDC"
      title="Build on Decades of NHLBI Research"
      tone="muted"
    >
      <div class="grid-container padding-x-0">
        <div class="grid-row grid-gap-md">
          <div class="grid-col-8 padding-top-2">
            <div class="grid-container padding-left-0 padding-right-2">
              <div class="grid-row grid-gap-md margin-bottom-2">
                <div class="grid-col-6 display-flex flex-align-stretch">
                  <Card>
                    <h3 class="font-heading-lg margin-top-1">Longitudinal &<br /> Epidemiologic Data</h3>
                    <p class="usa-prose">
                      Long-running cohort and observational studies with repeated measures over time
                    </p>
                  </Card>
                </div>
                <div class="grid-col-6 display-flex flex-align-stretch">
                  <Card>
                    <h3 class="font-heading-lg margin-top-1">Phenotypic &<br /> Clinical Data</h3>
                    <p class="usa-prose">
                      Detailed health, behavioral, environmental, and clinical characterization
                    </p>
                  </Card>
                </div>
              </div>
              <div class="grid-row grid-gap-md margin-bottom-2">
                <div class="grid-col-6 display-flex flex-align-stretch">
                  <Card>
                    <h3 class="font-heading-lg margin-top-1">Genomic &<br /> Omics Data</h3>
                    <p class="usa-prose">
                      Whole-genome sequencing and complementary molecular data
                    </p>
                  </Card>
                </div>
                <div class="grid-col-6 display-flex flex-align-stretch">
                  <Card>
                    <h3 class="font-heading-lg margin-top-1">Specialized HLBS Data</h3>
                    <p class="usa-prose">
                      Imaging, sleep, physiological, and disease-specific research data
                    </p>
                  </Card>
                </div>
              </div>
            </div>
            <div class="maxw-mobile-lg margin-x-auto padding-top-4">
              <Card variant="feature" class="bg-primary-lightest" border={false}>
                <h3 class="text-center margin-y-1">Analyze together in BDC</h3>
                <p class="usa-prose text-center">
                  Connect data across studies and data types to ask questions that extend beyond a single dataset.
                </p>
              </Card>
            </div>
          </div>
          <div class="grid-col-4">
            <div class="grid-container padding-left-4 padding-right-0 border-left border-base-lighter">
              <div class="grid-row">
                <div class="text-uppercase text-bold text-ls-2 font-sans-2xs margin-top-3 text-primary-darker">A data snapshot</div>
                <p class="text-primary-dark">
                  A growing resource with broad coverage and deep scientific value.
                </p>
              </div>
              <div class="grid-row">
                <div class="width-full border-bottom border-base-lighter display-flex padding-2">
                  <IconBadge icon="share" tone="neutral" class="margin-right-2" />
                  <div>
                    <div class="font-heading-2xl text-bold margin-bottom-1">123</div>
                    <div class="text-uppercase text-ls-2 font-sans-2xs margin-bottom-1">things</div>
                    <div class="text-base-light font-sans-2xs">with extra details</div>
                  </div>
                </div>
              </div>
              <div class="grid-row">
                <div class="width-full border-bottom border-base-lighter display-flex padding-2">
                  <IconBadge icon="layers" tone="neutral" class="margin-right-2" />
                  <div>
                    <div class="font-heading-2xl text-bold margin-bottom-1">123</div>
                    <div class="text-uppercase text-ls-2 font-sans-2xs margin-bottom-1">things</div>
                    <div class="text-base-light font-sans-2xs">with extra details</div>
                  </div>
                </div>
              </div>
              <div class="grid-row">
                <div class="width-full border-bottom border-base-lighter display-flex padding-2">
                  <IconBadge icon="network" tone="neutral" class="margin-right-2" />
                  <div>
                    <div class="font-heading-2xl text-bold margin-bottom-1">123</div>
                    <div class="text-uppercase text-ls-2 font-sans-2xs margin-bottom-1">things</div>
                    <div class="text-base-light font-sans-2xs">with extra details</div>
                  </div>
                </div>
              </div>
              <div class="grid-row">
                <div class="display-flex padding-2">
                  <IconBadge icon="cloud-outline" tone="warm" class="margin-right-2" />
                  <div>
                    <div class="font-heading-2xl text-bold">123</div>
                    <div class="text-uppercase text-ls-2 font-sans-2xs">things</div>
                    <div class="text-base-light font-sans-3xs">with extra details</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </PageSection>

    <PageSection
      title="Start Your Research Journey"
      centered
      tone="muted"
    >
      <Fragment slot="description">
        <p>
          BDC helps researchers move from finding a relevant study
          to asking questions across multiple datasets.
          Explore NHLBI data, identify studies or cohorts
          that fit your research question,
          and move directly into secure cloud environments
          where data can be analyzed individually or together.
        </p>
        <p>
          BDC supports the research process from data discovery and access
          through analysis, collaboration, reproducibility, and publication.
        </p>
      </Fragment>
      <Notice icon="attach_money" tone="cool">
        Cloud Credits may be available for you to get started.&nbsp;
        <Link to="/help/costs" class="text-bold">Learn about usage costs and cloud credits</Link>.
      </Notice>
      <ProcessSteps steps={lifecycleSteps} tone="muted" />
      <Notice
        icon="support"
        tone="warm"
        class="margin-top-5 margin-bottom-0 text-center text-primary-darker"
      >
        <span class="margin-right-1">Need help with BDC?</span>{' '}
        <Link to="/help/get-help" class="text-bold">
          Submit a request
        </Link>.
      </Notice>

      <div
        class="usa-modal-wrapper is-hidden"
        id="home-overview-video-modal"
        data-modal
        data-modal-autoplay-media="true"
        aria-hidden="true"
        role="dialog"
        aria-modal="true"
        aria-labelledby="home-overview-video-title"
      >
        <div class="usa-modal-overlay" tabindex="-1">
          <div class="usa-modal usa-modal--lg">
            <div class="usa-modal__content">
              <div class="usa-modal__main">
                <h2 id="home-overview-video-title" class="usa-modal__heading">BDC Two-Minute Overview</h2>
                <YouTubeEmbed id="enWIpA0aJb4" title="BDC two-minute overview" />
              </div>
              <button class="usa-button usa-modal__close" type="button" aria-label="Close video dialog" data-modal-close>
                <Icon name="close" size={4} />
              </button>
            </div>
          </div>
        </div>
      </div>
    </PageSection>

    <PageSection
      eyebrow="Featured Datasets"
      title="Explore NHLBI Data for Analysis"
      action={{ label: 'View all datasets', href: '/about/research-communities' }}
      tone="default"
    >
      <p slot="description">
        Discover data from NHLBI-supported studies and programs,
        including resources that can be used together
        to investigate questions across populations, phenotypes, and molecular data.
      </p>
      <div class="grid-row grid-gap-3 margin-bottom-neg-3">
        {featuredCommunities.map((program, index) => (
          <div class="tablet:grid-col-6 desktop:grid-col-6 flex-align-stretch margin-bottom-3">
            <ResearchCommunityCard
              mediaVariant={Math.min(index + 1, 4) as 1 | 2 | 3 | 4}
              title={program.key}
              description={program.excerpt}
              badgeLabel={program.description}
              metric={`${program.doc_count} dataset${program.doc_count === 1 ? '' : 's'}`}
              href={`/about/studies/${program.slug}`}
            />
          </div>
        ))}
      </div>

      <p class="margin-top-4 margin-bottom-2 display-flex flex-justify-center">
        <Link class="text-bold" to="/about/studies">Explore all BDC data</Link>
      </p>
    </PageSection>

    {
      featuredPublications.length > 0 && (
        <PageSection
          eyebrow="Latest Publications"
          title="Research in Action"
          action={{ label: 'View all publications', href: '/news/bdc-enabled-research' }}
          tone="highlight"
        >
          <p slot="description">
            See what researchers are discovering with BDC. Explore recent publications that use
            BDC data, computing resources, and analytical tools to answer scientific questions.
          </p>
          <div class="display-flex flex-column">
            {featuredPublications.map((publication) => (
              <div class="margin-bottom-2">
                <CardCopy
                  eyebrow="Recent Publication"
                  title={publication.title}
                  description={`Published in ${publication.journalName} on ${dateFormat.format(publication.date)}`}
                  href={publication.url}
                  linkLabel="View Publication"
                />
              </div>
            ))}
          </div>
        </PageSection>
      )
    }

    <TwoColumnSection
      eyebrow="Learning & Training"
      title="Training Opportunities with BDC"
      description="Give students and emerging researchers hands-on experience with real-world 
      biomedical data science without requiring institutions to build specialized 
      computational infrastructure."
      ctaLabel="Explore BDC for Learning and Training"
      ctaHref="/about/learning-and-training"
      mediaImage={homeCoursesImage}
      mediaAlt=""
    >
      <Notice icon="attach_money" tone="cool">
        Cloud Credits may be available for courses and training.<br />
        <Link to="/help/costs" class="text-bold">Learn more</Link>.
      </Notice>
    </TwoColumnSection>

    <PageSection
      eyebrow="Latest from BDC"
      title="What's Happening"
      action={{ label:'View all news', href: '/news/latest-updates' }}
      tone="muted"
    >
      <div class="grid-row grid-gap-3 flex-align-stretch">
        <div class="tablet:grid-col-6 margin-bottom-2 tablet:margin-bottom-0">
          {
            leadNews && (
              <HappeningCard
                kind="news"
                lead
                meta={`Published · ${dateFormat.format(leadNews.data.date)}`}
                title={leadNews.data.title}
                summary={leadNews.data.excerpt ?? 'Excerpt not found'}
                href={`/news/latest-updates/${leadNews.id}/`}
                linkLabel="View full update"
              />
            )
          }
        </div>

        <div class="tablet:grid-col-6">
          <div class="display-grid">
            {
              secondaryNews && (
                <div class="margin-bottom-2">
                  <HappeningCard
                    kind="news"
                    meta={`Published · ${dateFormat.format(secondaryNews.data.date)}`}
                    title={secondaryNews.data.title}
                    href={`/news/latest-updates/${secondaryNews.id}/`}
                    linkLabel="View full update"
                  />
                </div>
              )
            }
            {
              nextEvent && (
                <HappeningCard
                  kind="event"
                  meta={`Upcoming · ${dateFormat.format(nextEvent.data.date)}`}
                  title={nextEvent.data.title}
                  href={`/news/events/${nextEvent.id}/`}
                  linkLabel="View event details"
                />
              )
            }
          </div>
        </div>
      </div>
    </PageSection>

    <PageSection
      eyebrow="Researcher Perspectives"
      title="What BDC Researchers Are Saying"
      class="border-top border-bottom border-base-lighter"
      tone="muted"
    >
      {featuredTestimonial && (
        <div class="grid-row grid-gap-2">
          <div class="grid-col-12">
            <Blockquote attribution={featuredTestimonialAttribution} class="margin-x-auto maxw-tablet-lg">
              {featuredTestimonial.quote}
            </Blockquote>
          </div>
        </div>
      )}
    </PageSection>

    <section class="cta-band padding-y-10">
      <div class="grid-container cta-band__inner display-grid flex-align-center gap-2">
        <div>
          <h2 class="margin-0 text-base-lightest">Ready to Work in BDC?</h2>
          <p class="cta-band__description margin-top-1 margin-bottom-0">
            Get help finding data or using our secure cloud workspace.
          </p>
        </div>
        <div class="usa-button-group margin-top-6">
          <Button to="/help/get-help" variant="accent-warm">Get Help</Button>
          <Button to="https://bdcatalyst.gitbook.io/biodata-catalyst-documentation" variant="outline-inverse">Documentation</Button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style lang="scss">
  @use "@bdc/uswds-theme/src/uswds-init" as core;

  $cta-band-start: core.core-color(core.$theme-color-primary-darker);
  $cta-band-end: core.core-color(core.$theme-color-primary);

  .home-page {
    background: linear-gradient(180deg, #f7fbff 0%, #ffffff 30%, #f8fbff 100%);
  }

  .cta-band {
    background:
      radial-gradient(circle at 10% 20%, rgb(63 122 212 / 42%) 0%, transparent 28%),
      radial-gradient(circle at 86% 26%, rgb(239 158 70 / 30%) 0%, transparent 26%),
      linear-gradient(130deg, $cta-band-start 0%, $cta-band-end 100%);
    color: core.core-color('white');
  }

  .cta-band__inner {
    grid-template-columns: 1fr;
  }

  .cta-band__description {
    max-width: 58ch;
  }

  .home-hero-visual {
    isolation: isolate;
  }

  .home-hero-visual__halo {
    border-radius: 999px;
    filter: blur(24px);
    opacity: 0.8;
    pointer-events: none;
    position: absolute;
    z-index: 1;
  }

  .home-hero-visual__halo--left {
    background: radial-gradient(circle, rgb(93 173 255 / 42%) 0%, transparent 68%);
    height: 240px;
    left: -74px;
    top: -30px;
    width: 240px;
  }

  .home-hero-visual__halo--right {
    background: radial-gradient(circle, rgb(245 164 91 / 38%) 0%, transparent 70%);
    bottom: -64px;
    height: 210px;
    right: -66px;
    width: 210px;
  }

  @media (min-width: 64em) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
