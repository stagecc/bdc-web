---
import Card from '@bdc/ui-astro/card/Card.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import Base from '@layouts/Base.astro';
---

<Base title="Page Not Found" indexForSearch={false}>
  <Hero
    eyebrow="Error 404"
    title="We could not find that page"
    description="The page may have moved, been removed, or the address may be incorrect. Use one of the paths below to get back on track."
    primaryCta={{ label: 'Go to Homepage', href: '/' }}
    secondaryCta={{ label: 'Get Help', href: '/help/get-help' }}
  >
    <div slot="visual" aria-hidden="true">
      <Card variant="feature">
        <div class="display-flex flex-align-center gap-1 margin-bottom-1">
          <IconBadge icon="priority_high" tone="warm" size={4} />
          <p class="margin-0 margin-left-1 text-bold text-accent-warm-dark">Route not found</p>
        </div>
        <p class="text-base">Check the address or choose a common path below.</p>
      </Card>
    </div>
  </Hero>

  <section class="usa-section padding-top-4 padding-bottom-8">
    <div class="grid-container">
      <h2 class="margin-top-0">Popular paths</h2>
      <div class="grid-row grid-gap-3">
        <div class="tablet:grid-col-6 desktop:grid-col-3 display-flex flex-align-stretch margin-bottom-2">
          <Card variant="overview" class="height-full">
            <h3 class="margin-top-0 margin-bottom-2 text-primary-dark font-heading-sm">Data</h3>
            <ul class="usa-list margin-y-0">
              <li><Link to="/data/explore">Explore Data</Link></li>
              <li><Link to="/data/analyze">Analyze Data</Link></li>
              <li><Link to="/data/share">Share Data</Link></li>
            </ul>
          </Card>
        </div>
        <div class="tablet:grid-col-6 desktop:grid-col-3 display-flex flex-align-stretch margin-bottom-2">
          <Card variant="overview" class="height-full">
            <h3 class="margin-top-0 margin-bottom-2 text-primary-dark font-heading-sm">News</h3>
            <ul class="usa-list margin-y-0">
              <li><Link to="/news/latest-updates">Latest Updates</Link></li>
              <li><Link to="/news/events">Events</Link></li>
              <li><Link to="/news/bdc-enabled-research">BDC-Enabled Research</Link></li>
            </ul>
          </Card>
        </div>
        <div class="tablet:grid-col-6 desktop:grid-col-3 display-flex flex-align-stretch margin-bottom-2">
          <Card variant="overview" class="height-full">
            <h3 class="margin-top-0 margin-bottom-2 text-primary-dark font-heading-sm">Help</h3>
            <ul class="usa-list margin-y-0">
              <li><Link to="/help/get-help">Get Help</Link></li>
              <li><Link to="/help/contact-and-support">Contact and Support</Link></li>
              <li><Link to="/help/faqs">FAQs</Link></li>
            </ul>
          </Card>
        </div>
        <div class="tablet:grid-col-6 desktop:grid-col-3 display-flex flex-align-stretch margin-bottom-2">
          <Card variant="overview" class="height-full">
            <h3 class="margin-top-0 margin-bottom-2 text-primary-dark font-heading-sm">About BDC</h3>
            <ul class="usa-list margin-y-0">
              <li><Link to="/about/bdc">About BDC</Link></li>
              <li><Link to="/about/research-communities">Research Communities</Link></li>
              <li><Link to="/about/learning-and-training">Learning and Training</Link></li>
            </ul>
          </Card>
        </div>
      </div>

      <p class="margin-top-3 margin-bottom-0 text-base-dark">
        Still stuck? Try the <Link to="/search">site search</Link> or <Link to="/help/get-help">submit a support request</Link>.
      </p>
    </div>
  </section>
</Base>
