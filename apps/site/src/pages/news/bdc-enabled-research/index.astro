---
import { getCollection } from 'astro:content';
import Card from '@bdc/ui-astro/card/Card.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Icon from '@components/Icon.astro';
import PublicationsExplorer from '@components/publications/PublicationsExplorer.tsx';
import Base from '@layouts/Base.astro';

const publications = (await getCollection('publications')).map((pub) => ({
  ...pub.data,
  date: pub.data.date.toISOString(),
}));
---

<Base title="BDC-Enabled Research">
  <Hero
    eyebrow="Research"
    title="BDC-Enabled Research"
    description="Discover publications that used BDC-hosted datasets, computational workspaces, tools, or other ecosystem resources."
    primaryCta={{ label: 'Submit a Publication', href: '/news/bdc-enabled-research/publication-submission' }}
    secondaryCta={{ label: 'Browse Publications', href: '#publications' }}
  >
    <div slot="visual" class="width-full maxw-mobile">
      <Card variant="panel" class="padding-3">
        <div class="display-flex flex-align-center margin-bottom-1">
          <Icon name="local_library" size={4} class="margin-right-1 text-primary" />
          <p class="margin-0 text-bold">Total Publications</p>
        </div>
        <p class="margin-y-0 font-heading-xl text-primary-dark">{publications.length}</p>
      </Card>
    </div>
  </Hero>

  <section class="usa-section">
    <div class="grid-container usa-prose usa-prose--full-width padding-top-6 margin-top-neg-6" id="publications" data-scroll-offset="1200">
      <p>
        Remember to include BDC's citation and acknowledgment in manuscripts submitted to journals.
      </p>
    </div>
    <div class="grid-container">
      <PublicationsExplorer client:visible publications={publications} />
    </div>
  </section>
</Base>
