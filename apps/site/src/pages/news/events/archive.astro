---
import { getCollection } from 'astro:content';
import CardCta from '@bdc/ui-astro/card/CardCta.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import BdcHostedIndicator from '@components/events/BdcHostedIndicator.astro';
import PastEventsList from '@components/events/PastEventsList.astro';
import InlineAlert from '@components/InlineAlert.astro';
import Base from '@layouts/Base.astro';

const now = new Date();

const past = (await getCollection('events'))
  .filter((e) => (e.data.end_date ?? e.data.date) < now)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Past Events">
  <Hero
    eyebrow="News"
    title="Past Events"
    description="Browse archived events from the BDC ecosystem, including links to recordings, slides, and additional resources when available."
    primaryCta={{ label: 'View Upcoming Events', href: '/news/events' }}
    secondaryCta={{ label: 'View Latest Updates', href: '/news/latest-updates' }}
  >
    <div slot="visual" class="width-full maxw-mobile-lg">
      <CardCta
        icon="event"
        title="Explore the archive"
        text={`${past.length} past event${past.length === 1 ? '' : 's'} available.`}
        href="#past-events"
        cta="Browse archive"
      />
    </div>
  </Hero>

  <section id="past-events" class="usa-section margin-x-auto padding-top-4">
    <div class="grid-container">
      <p class="usa-prose">Events denoted with
        <BdcHostedIndicator decorative size={20} class="text-baseline" />
        were hosted by BDC.
      </p>
      <InlineAlert variant="info">
        Don't see the event you're looking for? Check back soon as more materials are added.
      </InlineAlert>
      <section>
        {past.length > 0
          ? <PastEventsList items={past} />
          : <p>No past events found.</p>
        }
      </section>

    </div>
  </section>
</Base>
