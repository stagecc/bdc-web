---
import { type CollectionEntry, getCollection } from 'astro:content';
import NewsList from '@components/news/NewsList.astro';
import CardCta from '@bdc/ui-astro/card/CardCta.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Base from '@layouts/Base.astro';

const posts = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Explicit type, 'news' type is automatically generated from schema in content.config.ts
const postsByYear: Record<number, CollectionEntry<'news'>[]> = {};

for (const post of posts) {
  const year = post.data.date.getFullYear();

  if (!postsByYear[year]) {
    postsByYear[year] = [];
  }

  postsByYear[year].push(post);
}

const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base title="Latest Updates">
  <Hero
    eyebrow="News"
    title="Latest Updates"
    description="Stay current on BDC data releases, ecosystem updates, research highlights, newsletters, and other ecosystem news."
    primaryCta={{ label: 'Subscribe', href: '/join-bdc' }}
    secondaryCta={{ label: 'View Events', href: '/news/events' }}
  >
    <div slot="visual" class="width-full maxw-mobile">
      <CardCta
        icon="mail_outline"
        title="Never miss an update"
        text="Subscribe to receive monthly BDC updates and other announcements."
        href="/join-bdc"
        cta="Receive updates"
      />
    </div>
  </Hero>

  <section class="usa-section padding-top-3">
    <div class="grid-container">

      <p class="text-right text-base-dark font-ui-xs">Showing {posts.length} Updates</p>

      {years.map(year => (
        <section class="margin-top-4">
          <h2 class="margin-bottom-0">
            {year}
          </h2>
          <NewsList items={postsByYear[year]} />
        </section>
      ))}
    </div>
  </section>

</Base>
