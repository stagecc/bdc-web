---
import { type CollectionEntry, getCollection } from 'astro:content';
import Card from '@bdc/ui-astro/card/Card.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';
import Link from '@bdc/ui-astro/link/Link.astro';

import Base from '@layouts/Base.astro';

const coverage = (await getCollection('coverage')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// Explicit type, 'coverage' type is automatically generated from schema in content.config.ts
const coverageByYear: Record<number, CollectionEntry<'coverage'>[]> = {};

for (const item of coverage) {
  const year = item.data.date.getFullYear();

  if (!coverageByYear[year]) {
    coverageByYear[year] = [];
  }

  coverageByYear[year].push(item);
}

const years = Object.keys(coverageByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<Base title="News Coverage">
  <section class="usa-section">
    <div class="grid-container">
      <h1>News Coverage</h1>
      <div class="usa-prose usa-prose--full-width">
        <p>
          Explore external news articles and media coverage featuring BDC.
          Articles on this page are published by third-party organizations
          and will open on external websites. Some articles may require a
          subscription or login to access and are identified with a paywall
          notice <IconBadge icon="shield" tone="neutral" size={3} iconSize={3} class="text-middle margin-bottom-05" />.
        </p>
        <p class="text-bold">
          Showing {coverage.length} {coverage.length === 1 ? 'external news article' : 'external news articles'}
        </p>
      </div>
      {
        years.map((year) => (
          <section class="margin-top-4">
            <h2 class="font-heading-lg margin-bottom-2">{year}</h2>
            <ul class="usa-collection usa-list--unstyled margin-0">
              {coverageByYear[year].map((item) => (
                <li class="usa-collection__item margin-bottom-2 border-0">
                  <Card as="div" variant="panel">
                    <div class="usa-collection__body">
                      <h3 class="usa-collection__heading font-heading-md margin-top-0 margin-bottom-1">
                        <Link to={item.data.url}>{item.data.title}</Link>
                      </h3>

                      <ul class="usa-collection__meta usa-list--unstyled display-flex flex-wrap flex-justify flex-align-center ">
                        <li class="usa-collection__meta-item">
                          <span>
                            <time datetime={item.data.date.toISOString()}>
                              {item.data.date.toLocaleDateString('en-US', {
                                month: 'long',
                                day: 'numeric',
                              })}
                            </time>
                            •
                            <em>{item.data.source}</em>
                          </span>
                        </li>
                        {
                          item.data.paywall && (
                            <li class="usa-collection__meta-item margin-left-1 display-flex flex-align-center">
                              <IconBadge
                                icon="shield"
                                tone="neutral"
                                size={3}
                                iconSize={3}
                              />
                              <span class="margin-left-05">May require subscription</span>
                            </li>
                          )
                        }
                      </ul>
                    </div>
                  </Card>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</Base>
