---
import InlineAlert from '@bdc/ui-astro/alert/InlineAlert.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import ContactBdcForm from '@components/forms/freshdesk/composed/ContactBdcForm.astro';
import Base from '@layouts/Base.astro';
---

<Base title="Contact BDC" enableRecaptcha>
  <section class="usa-section">
    <div class="grid-container">

      <h1>Contact BDC</h1>
      <InlineAlert variant="info" heading="When to use this form ">
        <p class="margin-top-0">
          Use this form for general inquiries, partnerships, collaborations, outreach, and other questions that are not technical-support requests.
        </p>
        <p class="margin-bottom-0">
          Need help with an error, data access, account issue, or platform problem? <Link to="/help/get-help">Get Help instead→</Link>
        </p>
      </InlineAlert>

      <h2>Contact BDC Form</h2>
      <ContactBdcForm />
    </div>
  </section>
</Base>
