---
import { DugNextStepsApp } from '@components/dug';
import Base from '@layouts/Base.astro';
---

<Base title="Dug Next Steps">
  <section class="usa-section">
    <div class="grid-container usa-prose usa-prose--full-width">
      <h1>Dug Next Steps</h1>
      <p class="margin-y-2">
        Use your saved Dug concepts, studies, and variables to plan the right
        next action in BDC.
      </p>
      <DugNextStepsApp client:load />
    </div>
  </section>
</Base>
