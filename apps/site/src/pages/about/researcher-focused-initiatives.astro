---
import { getCollection, render } from 'astro:content';
import Button from '@bdc/ui-astro/button/Button.astro';
import Card from '@bdc/ui-astro/card/Card.astro';
import Icon from '@bdc/ui-astro/icon/Icon.astro';
import IconBadge from '@bdc/ui-astro/icon/IconBadge.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import InPageNav from '@components/layout/InPageNav.astro';
import Base from '@layouts/Base.astro';

const localEntries = await getCollection(
  'programContent',
  ({ data }) => data.showOnContentPage,
);
const apiPrograms = await getCollection('programs');
const apiById = new Map(apiPrograms.map((p) => [p.id, p]));

const sections = await Promise.all(
  localEntries.map(async (entry) => {
    const apiEntry =
      entry.data.dataAvailable !== false ? apiById.get(entry.id) : undefined;
    const { Content } = await render(entry);
    return {
      id: entry.id,
      name: entry.data.title ?? apiEntry?.data.name ?? entry.id,
      priority: entry.data.priority,
      dataAvailable: entry.data.dataAvailable,
      Content,
    };
  }),
);

const communitiesWithData = sections.filter(
  ({ dataAvailable }) => dataAvailable,
).length;

sections.sort((a, b) => {
  const aPriority = a.priority;
  const bPriority = b.priority;

  if (aPriority !== undefined && bPriority !== undefined) {
    return aPriority - bPriority;
  }
  if (aPriority !== undefined) return -1;
  if (bPriority !== undefined) return 1;
  return a.name.localeCompare(b.name);
});
---

<Base title="Researcher-Focused Initiatives">
  <Hero
    eyebrow="About BDC"
    titleLines={['Researcher-Focused', 'Initiatives']}
    description="See how BDC works with select research initiatives to bring valuable data and resources into the ecosystem and expand how researchers can use them."
  >
    <div slot="visual" class="width-full maxw-mobile-lg">
      <Card>
        <IconBadge icon="people" tone="secondary" size={6} iconSize={5} class="margin-bottom-2" />
        <div class="text-primary-dark font-heading-lg text-bold margin-bottom-3">More than hosting data</div>
        <div class="text-primary-darker text-bold font-sans-sm margin-bottom-1">
          BDC works with research initiatives to make complex data more accessible, usable, and ready for analysis
        </div>
      </Card>
    </div>
  </Hero>

  <section id="community-list" class="usa-section padding-top-4">
    <div class="grid-container">
      <InPageNav>
        <p>
          BDC collaborates with many of NHLBI's largest research communities by
          importing their data, integrating their resources (as appropriate), and
          providing analytical tools, applications, workflows, and secure
          workspaces.
        </p>
        <p>
          To support researchers from these communities when they start using the
          ecosystem, BDC develops and deploys enhancements, tailors the user
          onboarding process, and encourages participation in the greater BDC
          community. Researchers within these communities may use BDC to analyze
          scientific data collected from research protocols.
        </p>

        <div class="margin-bottom-8">
          {sections.map(({ id, name, dataAvailable, Content }) => (
            <section id={id} class="border-top-1px border-base-light margin-top-6">
              <h2>{name}</h2>
              <Content />
              {dataAvailable && (
                <Button to={`/about/studies/${id}`} centered>
                  See a list of the {name} data available in BDC
                </Button>
              )}
            </section>
          ))}
        </div>
      </InPageNav>

      <div class="usa-card usa-card__container padding-4 usa-prose">
        <Icon name="add_circle_outline" size={4} />
        <h3>Want to propose a new initiative?</h3>
        <p>
          Research initiatives interested in collaborating with BDC can express
          their interest with our Contact form.
        </p>
        <p>
          <Link to="/help/contact-and-support">
            → Propose New Research Community Collaboration
          </Link>
        </p>
      </div>
    </div>
  </section>
</Base>
