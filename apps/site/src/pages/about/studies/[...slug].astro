---
import { render } from 'astro:content';
import StatCard from '@bdc/ui-astro/card/StatCard.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Table from '@bdc/ui-astro/table/Table.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import Link from '@components/link/Link.astro';
import Base from '@layouts/Base.astro';
import {
  getProgramsWithContent,
  type ProgramWithContent,
} from '../../../util/programs';

interface Props {
  entry: ProgramWithContent;
}

export async function getStaticPaths() {
  const programs = await getProgramsWithContent();

  return programs
    .filter((entry) => entry.dataAvailable)
    .map((entry) => {
      const slug = entry.local?.id ?? entry.program.id;

      return {
        params: { slug },
        props: { entry },
      };
    });
}

const { entry }: Props = Astro.props;
const { program, local, title, excerpt } = entry;
const { description, studies } = program.data;
const { Content } = local ? await render(local) : { Content: undefined };

const datasetLabel = `${studies.length} hosted dataset${studies.length === 1 ? '' : 's'} in BDC`;
const heroDescription = excerpt ?? description;
const crumbs = [
  { label: 'BDC-Hosted Data', href: '/about/studies/' },
  { label: title },
];
---

<Base title={title}>
  <Hero
    eyebrow="BDC-Hosted Data"
    title={title}
    description={heroDescription}
  >
    <div slot="visual" class="width-full maxw-mobile-lg">
      <StatCard
        icon="layers"
        number={studies.length}
        qualifier="Hosted datasets"
        description="eRA Commons credentials and approved dbGaP access are required."
        float="right"
        tone="cool"
        width="100%"
      />
    </div>
  </Hero>

  <section class="usa-section padding-top-0">
    <div class="grid-container">
      <Breadcrumbs items={crumbs} />
      
      {
        Content && (
          <>
            <h3>Description</h3>
            <div class="study-description usa-prose margin-bottom-3" style="columns: 2; ">
              <Content />
            </div>
          </>
        )
      }
      <hr />
      <div id="community-datasets" class="margin-top-4">
        <Table
          class="width-full margin-top-0"
          caption={`Hosted datasets in BDC for ${title}`}
          captionSrOnly
          borderless
          striped
          stickyHeader
          sortable={['study-name', 'dbgap-accession']}
        >
          <!--
            z-index here keeps the dbGaP Accession link's
            external-link icon from rendering above the table header
          -->
          <thead class="height-8" style="z-index: 1;">
            <tr>
              <th scope="col" id="study-name" class="text-center">Study Name</th>
              <th scope="col" id="dbgap-accession" class="text-center">dbGaP Accession</th>
            </tr>
          </thead>
          <tbody>
            {studies.map((study) => (
              <tr>
                <td>{study.name}</td>
                <td>
                  {study.url ? <Link to={study.url}>{study.id}</Link> : study.id}
                </td>
              </tr>
            ))}
          </tbody>
        </Table>
      </div>

    </div>
  </section>

</Base>

<style>
  /* Removes the leading paragraph gap so content aligns cleanly under the Description heading. */
  .study-description :global(p:first-of-type) {
    margin-top: 0;
  }
</style>
