---
import Card from '@bdc/ui-astro/card/Card.astro';
import StatCard from '@bdc/ui-astro/card/StatCard.astro';
import Hero from '@bdc/ui-astro/layout/Hero.astro';
import Link from '@bdc/ui-astro/link/Link.astro';
import Base from '@layouts/Base.astro';
import {
  getProgramsWithContent,
  sortProgramsForDisplay,
} from '../../../util/programs';

const programs = (await getProgramsWithContent())
  .filter((entry) => entry.dataAvailable)
  .sort(sortProgramsForDisplay);

const totalDatasets = programs.reduce(
  (total, entry) => total + entry.program.data.numberOfStudies,
  0,
);
---

<Base title="Research Community Data">
  <Hero
    eyebrow="Hosted Datasets"
    titleLines={['Research', 'Community', 'Data']}
    description="Explore datasets contributed through BDC collaborations with NHLBI research communities."
    primaryCta={{ label: 'Explore Research Communities', href: '/about/research-communities' }}
    secondaryCta={{ label: 'Jump to Data Table', href: '#community-data' }}
  >
    <div slot="visual" class="width-full maxw-mobile-lg">
      <StatCard
        icon="database"
        number={totalDatasets}
        qualifier="Hosted datasets"
        meta={`${programs.length} research communities`}
        float="right"
        tone="cool"
        width="100%"
      />
    </div>
  </Hero>

  <section id="community-data" class="usa-section padding-top-4">
    <div class="grid-container">
      <p class="usa-prose margin-top-0 margin-bottom-3">
        Access to these datasets is limited to those with
        <Link to="https://public.era.nih.gov/commonsplus/public/login.era?TARGET=https%3A%2F%2Fpublic.era.nih.gov%3A443%2Fcommons">
          eRA Commons credentials
        </Link>
        &nbsp;and approved
        <Link to="https://dbgap.ncbi.nlm.nih.gov/aa/wga.cgi?page=login">
          data access requests
        </Link>
        &nbsp;through dbGaP.
      </p>

      <div class="display-block tablet:display-none">
        <div class="grid-row grid-gap-2">
          {programs.map(({ program, title, excerpt }) => (
            <div class="grid-col-12">
              <Card variant="panel" class="height-full">
                <h2 class="font-heading-sm margin-top-0 margin-bottom-1">
                  <Link to={`/about/studies/${program.id}`}>{title}</Link>
                </h2>
                <p class="font-sans-xs text-base-dark margin-y-1">
                  {excerpt ?? program.data.description}
                </p>
                <p class="margin-top-2 margin-bottom-0 text-bold font-sans-xs text-primary-darker">
                  {program.data.numberOfStudies} hosted dataset{program.data.numberOfStudies === 1 ? '' : 's'}
                </p>
              </Card>
            </div>
          ))}
        </div>
      </div>

      <div class="overflow-auto display-none tablet:display-block">
        <table class="usa-table usa-table--borderless usa-table--striped width-full">
          <caption class="usa-sr-only">Research community datasets available in BDC</caption>
          <thead>
            <tr>
              <th scope="col">Research Community</th>
              <th scope="col">Overview</th>
              <th scope="col">Hosted Datasets</th>
            </tr>
          </thead>
          <tbody>
            {programs.map(({ program, title, excerpt }) => (
              <tr>
                <th scope="row">
                  <Link to={`/about/studies/${program.id}`}>{title}</Link>
                </th>
                <td>{excerpt ?? program.data.description}</td>
                <td>{program.data.numberOfStudies}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

    </div>
  </section>

</Base>
