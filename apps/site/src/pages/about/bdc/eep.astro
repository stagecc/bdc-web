---
import { getCollection, render } from 'astro:content';
import StatCard from '@bdc/ui-astro/card/StatCard.astro';
import PageSection from '@bdc/ui-astro/layout/PageSection.astro';
import EepMember from '@components/eep/EepMember.astro';
import Base from '@layouts/Base.astro';
import { sortByLastName } from '../../../util/sort-by-lastName';

// Fetch all EEP members
const members = await getCollection('eep');
const adHocMemberCount = members.filter((member) => member.data.adhoc).length;

// Sort: alphabetical by last name, adhoc members last
const sorted = sortByLastName(
  members,
  (member) => member.data.slug,
  (member) => member.data.adhoc,
);

// Render markdown body for each member
const rendered = await Promise.all(
  sorted.map(async (member) => {
    const { Content } = await render(member);
    return { member, Content };
  }),
);
---

<Base title="BDC External Expert Panel">
  <section class="usa-section">
    <div class="grid-container">
      <h1>BDC External Expert Panel</h1>
      <div class="usa-prose usa-prose--full-width">
        <StatCard
          icon="people"
          number={members.length - adHocMemberCount}
          qualifier="Panel Members"
          meta={`Plus ${adHocMemberCount} Ad-hoc Member${adHocMemberCount === 1 ? '' : 's'}`}
          description="Independent experts advising NHLBI leadership on the BDC ecosystem"
          float="right"
          tone="cool"
        />
        <p>
          The BDC External Expert Panel (EEP) is an independent body of experts that 
          provides feedback and input that helps NHLBI make strategic decisions about 
          the BDC program.
        </p>
        <p>
          The expertise of EEP members spans biomedical informatics, artificial 
          intelligence, genomics, data science, cyberinfrastructure, education, and 
          clinical research. Members volunteer their time and insights over multi-year 
          terms to help ensure BDC continues to meet the needs of the research community.
        </p>
      </div>
    </div>
  </section>

  <PageSection title="Current Members">

    {rendered.map(({ member, Content }) => (
      <EepMember
        name={member.data.name}
        slug={member.data.slug}
        signifier={member.data.signifier}
        roles={member.data.roles}
        photo={member.data.photo}
        adhoc={member.data.adhoc}
      >
        <Content />
      </EepMember>
    ))}
  </PageSection>
</Base>
