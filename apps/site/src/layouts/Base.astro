---
import { ClientRouter } from 'astro:transitions';
import { AnalyticsController } from '@components/layout/AnalyticsController';
import { ExitNoticeController } from '@components/layout/ExitNoticeController';
import { ModalController } from '@components/layout/ModalController';
import SiteAlertList from '@components/layout/SiteAlertList.astro';
import SiteFooter from '@components/layout/SiteFooter.astro';
import { SiteHeader } from '@components/layout/SiteHeader';
import SearchResultEnhancementTemplates from '@components/search/SearchResultEnhancementTemplates.astro';
import SearchResultTemplates from '@components/search/SearchResultTemplates.astro';
import '../styles/global.scss';

interface Props {
  title: string;
  // Pass enableRecaptcha on any page that includes a form.
  // Scopes the reCAPTCHA script to only pages that need it,
  // avoiding unnecessary Google script loading sitewide.
  enableRecaptcha?: boolean;
  indexForSearch?: boolean;
}

const { title, enableRecaptcha = false, indexForSearch = true } = Astro.props;
const isHomePage = Astro.url.pathname === '/';
const displayTitle = title.includes('BioData Catalyst')
  ? title
  : `${title} | BioData Catalyst`;
const gaId = import.meta.env.PUBLIC_GA_ID;
const hasGa = typeof gaId === 'string' && gaId.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{displayTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link href="/pagefind/pagefind-component-ui.css" rel="stylesheet" />
    <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
    {hasGa && (
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
      />
    )}
    {hasGa && (
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer ?? [];
        window.gtag =
          window.gtag ||
          function gtag() {
            window.dataLayer.push(arguments);
          };

        if (!window.__bdcGaInitialized) {
          window.gtag('js', new Date());
          window.gtag('config', gaId, { send_page_view: false });
          window.__bdcGaInitialized = true;
        }
      </script>
    )}
    <ClientRouter />
    {enableRecaptcha && (
      <script
        src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`}
        async
        defer
      />
    )}
  </head>
  <body data-pagefind-ignore class="display-flex flex-column minh-viewport">
    {hasGa && <AnalyticsController client:only="react" />}
    <a class="usa-skipnav" href="#main-content">Skip to main content</a>
    <SiteAlertList isHomePage={isHomePage} />
    <SiteHeader client:load transition:persist />
    <ExitNoticeController client:only="react" />
    <ModalController client:only="react" />
    <SearchResultEnhancementTemplates />
    <pagefind-modal instance="site-modal" reset-on-close>
      <pagefind-modal-header>
        <pagefind-input instance="site-modal"></pagefind-input>
      </pagefind-modal-header>
      <pagefind-modal-body>
        <pagefind-summary instance="site-modal"></pagefind-summary>
        <pagefind-results instance="site-modal">
          <SearchResultTemplates />
        </pagefind-results>
      </pagefind-modal-body>
      <pagefind-modal-footer>
        <pagefind-keyboard-hints instance="site-modal"></pagefind-keyboard-hints>
      </pagefind-modal-footer>
    </pagefind-modal>
    <main id="main-content" data-pagefind-body={indexForSearch || undefined} class="flex-1">
      <slot />
    </main>
    <SiteFooter />
    <script src="../scripts/init-search-modal.ts"></script>
  </body>
</html>
