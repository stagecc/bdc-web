---
import { ClientRouter } from 'astro:transitions';
import { AnalyticsController } from '@components/layout/AnalyticsController';
import { ExitNoticeController } from '@components/layout/ExitNoticeController';
import { ModalController } from '@components/layout/ModalController';
import SiteAlertList from '@components/layout/SiteAlertList.astro';
import SiteFooter from '@components/layout/SiteFooter/index.astro';
import { SiteHeader } from '@components/layout/SiteHeader';
import '../styles/global.scss';

interface Props {
  title: string;
  // Pass enableRecaptcha on any page that includes a form.
  // Scopes the reCAPTCHA script to only pages that need it,
  // avoiding unnecessary Google script loading sitewide.
  enableRecaptcha?: boolean;
}

const { title, enableRecaptcha = false } = Astro.props;
const isHomePage = Astro.url.pathname === '/';
const displayTitle = title.includes('BioData Catalyst')
  ? title
  : `${title} | BioData Catalyst`;
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const hasGtm = typeof gtmId === 'string' && gtmId.length > 0;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{displayTitle}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
    {enableRecaptcha && (
      <script
        src={`https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`}
        async
        defer
      />
    )}
    <style>
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
    </style>
  </head>
  <body data-pagefind-ignore>
    {hasGtm && <AnalyticsController client:load gtmId={gtmId} />}
    {hasGtm && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
          title="Google Tag Manager"
        />
      </noscript>
    )}
    <a class="usa-skipnav" href="#main-content">Skip to main content</a>
    <SiteAlertList isHomePage={isHomePage} />
    <SiteHeader client:load transition:persist />
    <ExitNoticeController client:only="react" />
    <ModalController client:only="react" />
    <main id="main-content" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
