---
import InPageNav from '@components/layout/InPageNav/index.astro';
import Base from '@layouts/Base.astro';

interface Props {
  frontmatter: {
    title: string;
    // Optional date string displayed as "Last Reviewed"
    // at the top of the page.
    // Example format used across the site: "June 2026".
    lastReviewed?: string;
    in_page_nav?: boolean;
  };
}

const { frontmatter }: Props = Astro.props;
const showNav = frontmatter.in_page_nav !== false;
---

<Base title={frontmatter.title}>
  <section class="usa-section">
    <div class="grid-container">
      <h1>{frontmatter.title}</h1>
      {
        frontmatter.lastReviewed && (
          <p style=" font-size: 0.875rem; margin-top:0">
            Last Reviewed: {frontmatter.lastReviewed}
          </p>
        )
      }

      {
        showNav ? (
          <InPageNav>
            <slot />
          </InPageNav>
        ) : (
          <div class="usa-prose--full-width usa-prose">
            <slot />
          </div>
        )
      }
    </div>
  </section>
</Base>
