---
import { Image } from 'astro:assets';
import Link from '@bdc/ui-astro/link/Link.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import EmailSignup from '@components/EmailSignup.astro';
import ArticleHeader from '@components/news/ArticleHeader.astro';
import Base from '@layouts/Base.astro';

const { frontmatter, newerPost, olderPost } = Astro.props;

const crumbs = [
  { label: 'Latest Updates', href: '/news/latest-updates/' },
  { label: frontmatter.title },
];

const { title, date, tags, updateType, heroImage, heroAlt } = frontmatter;

const updateTypeCardText = {
  Newsletter: `Read the latest newsletter, including recent ecosystem news, 
    data updates, events, training opportunities, and reminders for the BDC community.
    This newsletter opens in Mailchimp.`,
  'Release Notes': `The BDC release notes summarize recent updates across the BDC ecosystem, 
  including data availability, documentation, and platform functionality.`,
};
---

<Base title={title}>

  <section class="usa-section">
    <article class="article">
      <div class="grid-container">

        <Breadcrumbs items={crumbs} />

        <ArticleHeader
          title={title}
          date={date}
          tags={tags}
          updateType={updateType}
        />

        {heroImage && (
          <Image
            src={heroImage}
            alt={heroAlt || ''}
            class="article__hero"
          />
        )}

      {
        (updateType === "Newsletter" || updateType === "Release Notes") && (
          <div class="usa-card margin-top-4">
            <div class="usa-card__container">
              <div class="usa-card__body">
                <p class="margin-0 font-sans-sm">
                  {updateTypeCardText[updateType]}
                </p>
              </div>
            </div>
          </div>
        )
      }

        <div class="article__content clearfix line-height-sans-5">
          <slot />
        </div>

        {
          (updateType === "Newsletter" || updateType === "Release Notes") && (
            <EmailSignup/>
          )
        }
        
        <nav aria-label="More news articles" class="margin-top-10">
          <div class="display-flex flex-justify grid-row">
            {olderPost && (
              <Link to={`/news/latest-updates/${olderPost.id}/`} rel="prev" class="grid-col-4">
                ← PREVIOUS
                <span class="usa-collection__meta-item">
                  {olderPost.data.title}
                </span>
              </Link>
            )}
            {newerPost && (
              <Link to={`/news/latest-updates/${newerPost.id}/`} rel="next" class="grid-col-4 text-right">
                NEXT →
                <span class="usa-collection__meta-item">
                  {newerPost.data.title}
                </span>
              </Link>
            )}
          </div>
        </nav>
      </div>
    </article>
  </section>

</Base>

<style>
  .article__hero {
    width: 100%;
    height: auto;
    margin-bottom: 2rem;
    border-radius: 4px;
  }
</style>
