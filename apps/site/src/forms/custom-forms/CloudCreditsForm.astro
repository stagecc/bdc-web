---
import DynamicForm from '@components/forms/DynamicForm.tsx';
import { getFormFields } from '../../util/freshdesk/getFormFields';
import type { FreshdeskField } from '../../util/freshdesk/types';

let fields: FreshdeskField[] = [];
let formError = false;
const hasFreshdeskAuth =
  Boolean(import.meta.env.FRESHDESK_DOMAIN) &&
  Boolean(import.meta.env.FRESHDESK_API_KEY);
const formId = import.meta.env.FRESHDESK_FORM_USAGE_COSTS_CLOUD_CREDITS;

if (!hasFreshdeskAuth || !formId) {
  console.warn(
    'Skipping cloud credits form field fetch: missing Freshdesk credentials or form ID.',
  );
  formError = true;
} else {
  try {
    fields = await getFormFields(formId);
  } catch (e) {
    console.error('Failed to fetch cloud credits form fields:', e);
    formError = true;
  }
}
---

<DynamicForm
  fields={fields}
  formType="Usage Costs/Cloud Credits"
  submitUrl={import.meta.env.FRESHDESK_PROXY_URL}
  recaptchaSiteKey={import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}
  error={formError}
  client:visible
/>
